			'Не хотите ли вы станцевать со смертью?'
			'''
	}

	FrigidCoil: {
		DisplayName: Морозная катушка
		Tooltip:
			'''
			Снижает скорость стрелковых атак на 10%
			Умеренно увеличивает скорость стрелковых снарядов
			Стрелковые снаряды накладывают дебафф [cbuff:Frostburn]
			Призывает морозные бомбы вокруг поражённого врага
			Имеет 5 секунд перезарядки
			'''
	}

	ScorchingCoil: {
		DisplayName: Искрящаяся катушка
		Tooltip:
			'''
			Увеличивает шанс стрелкового критического удара на 7%
			Умеренно увеличивает скорость стрелковых снарядов
			Стрелковые снаряды накладывают дебафф [cbuff:CalamityMod/BrimstoneFlames]
			Стреляет дугообразным шквалом из шести серных взрывов каждые 6 попаданий стрелковыми атаками
			Попадания от снарядов, способных наносить урон несколько раз подряд, будут учитываться лишь 1 раз
			'''
	}

	AutoCalculationCoil: {
		DisplayName: Авто-наводящаяся катушка Дрэйдона
		Tooltip:
			'''
			Умеренно увеличивает скорость стрелковых снарядов
			Даёт стрелковым снарядам самонаводку
			Нажмите [KEY], чтобы переключить алгоритм наводки
			'''
	}

	TransformerCoil: {
		DisplayName: Трансформирующая катушка
		Tooltip:
			'''
			Значительно увеличивает скорость стрелковых снарядов
			Даёт невосприимчивость к дебаффу [cbuff:Electrified], а ваши атаки будут накладывать его
			A surge of electricity will flicker on the last two enemies you hit
			'''
	}

	AuricBullet: {
