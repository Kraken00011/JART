ItemDescriptions: {
	GrenadeLauncher:
		'''
		Удерживайте ПКМ, чтобы ускорить детонацию мин
		Отпустите ПКМ, чтобы мгновенно взорвать все выпущенные заряды
		'''
	RocketLauncher:
		'''
		Нажмите ПКМ, чтобы отметить ближайшего к вашему курсору врага
		Ракеты будут нацеливаться на отмеченного врага
		'''
	NettleBurst:
		'''
		Нажмите ЛКМ, чтобы выстрелить колючками
		Нажмите ПКМ, чтобы выстрелить пучком семян, расцветающих при попадании по врагу
		При попадании колючками по цветенью взрывает его
		Ближайшие колючки рвутся во время детонации цветка
		Когда цветок взрывается, ближайшие к нему цветки также начнут взрываться
		После взрыва даёт временное усиление для нескольких следующих атак колючками
		'''
	ChlorophyteBullet:
		'''
		Может пронзать несколько врагов и отскакивать от поверхностей
		Отскакивает в сторону врага, если таковой есть поблизости
		'''
	ChlorophyteClaymore:
		'''
		, отскакивающей от поверхностей
		Удерживайте ЛКМ, чтобы зарядить клеймор, а затем отпустите для выстрела мощной заряженной атакой
		Заряженные атаки высвобождают мощные ударные волны, также отскакивающие от поверхностей
		Нажмите ПКМ, чтобы атаковать как обычно
		'''
	ChlorophyteSaber: При попадании по врагу высвобождает облако спор
	ChlorophytePartisan:
		'''
		Атаки создают листья, движущиеся вместе с игроком
		Каждую 3 атаку протазан проталкивается вперёд, выпуская эти листья и давая им самонаводку
		'''
	GolemEye: Каждый 5 удар гарантировано будет критическим
	Stynger: Нажмите ПКМ, чтобы выстрелить пучком болтов
	HeatRay:
		'''
		С течением времени луч начнёт нагреваться, увеличивая свой урон
		Полностью нагретый луч будет накладывать дебафф «{$BuffName.OnFire3}» и плавить вражескую броню
		Попадания лучом по врагам с дебаффом «{$BuffName.OnFire3}» могут вызвать взрыв
		'''
	NanoBullet: Накладывает дебафф «{$BuffName.Confused}» и самонаводится на врагов
	PulseBow:
		'''
		Нажмите ЛКМ, чтобы сделать обычный выстрел
		Удерживайте ЛКМ, чтобы зарядить лук и увеличить мощность выстрела
		Полностью заряженные выстрелы конвертируют обычные стрелы в импульсные болты
		Каждые 3 последовательных заряженных выстрела будут усиливать 2 последующие атаки, временно конвертируя выпускаемые болты в импульсные лучи
		После отстрела всех усиленных атак зарядка лука будет временно замедлена
		При ношении грибнитового комплекта вы сможете оставаться в невидимости даже во время атаки луком
		'''
	LaserMachineGun: При достижении максимальной скорострельности создаёт щит, увеличивающий сопротивление урону до 25%
	ButchersChainsaw:
		'''
		При постоянном нанесении урона позволяет задерживаться в воздухе
		Нажмите ПКМ, чтобы бросить бензопилу, которая ненадолго вонзится во врага, нанося ему постоянный урон в течение этого времени
		Только 2 бензопилы можно бросить одновременно
		'''

	ShinyStone: {
		Tooltip:
			'''
			Немного увеличивает защиту соразмерно недостающему здоровью
			Сокращает время, нужное для достижения максимальной регенерации здоровья
			Значительно сокращает время, нужное для начала регенерации маны
			'''
		TooltipFlavor: "'Станьте хранителем'"
		TooltipThoriumMod: Увеличивает лучезарный урон, скорость произнесения заклинаний и шанс критического удара на 10%
		TooltipGeneral: Даёт эффекты от предмета «{$ItemName.ShinyStone}»
	}
}

Buffs: {
	GolemMount: {
		DisplayName: Яхщеровый мех
		Description:
			'''
			Защита значительно увеличена
			'Яхщер в бронированном костюме. А снять, кто ты без него?'
			'''
	}
}

Items: {
	CursedTotem: {
		DisplayName: Проклятый тотем
		Tooltip:
			'''
			Призывает одержимые яхщеровые статуи
			Статуи не могут находиться на платформах
			'''
	}

	GraspofGrass: {
		DisplayName: Природные объятия
		Tooltip:
			'''
			Стреляет семенами в комбо из шести выстрелов:
			Первые 2 выстрела выпускают ядовитые семена с большим уроном, но с большой задержкой между выстрелами
			Следующие 3 выстрела выпускают отравляющие семена с пониженным уроном, но с минимальной задержкой
			Последний выстрел выпускают пронзающий колючий шар
			При ношении в руках призывает фею, наносящую урон призывателя и усиливающуюся от его бонусов
			Фея атакует только отмеченных меткой призывателя врагов
			При попадании по врагам семенами также оставляет на них невидимые метки призывателя
			Использует семена [i/s1:Seed] в качестве боеприпасов
			'Потрогай травы'
			'''
	}

	LihzahrdKey: {
		DisplayName: Яхщеровый меха-ключ
		Tooltip:
			'''
			Позволяет использовать тело Голема как собственное оружие
			'Почувствуйте себя в шкуре собственного врага!'
			'''
	}

	ScorchedEarth: {
		DisplayName: Землежёг
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы выпустить высокоскоростную стрелу
			Удерживайте ЛКМ, чтобы зарядить лук
			При полной зарядке выстреливает 3 медленно движущимися стрелами, самонаводящимися на врагов и вызывающими взрыв при попадании
			'''
	}

	Sunbracers: {
		DisplayName: Солнцестояние
		Tooltip:
			'''
			Конвертирует ракеты в маленькие солнца, способные некоторое время задерживаться на поверхности
			Пока находится на поверхности, мини-солнце периодически испускает горячую плазму, поджигающую врагов
			'Кто-то, по сей видимости, решил собрать себе мини-крематорий'
			'''
	}

	TempleLink: {
		DisplayName: Ссылка до Храма
		Tooltip:
			'''
			Телепортирует использовавшего к алтарю яхщеров
			'А вы знали, что яхщеры использовали лавовые лампы?'
			'''
	}
}

