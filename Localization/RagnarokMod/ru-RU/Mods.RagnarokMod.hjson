Tooltips: {
	WhiteDwarfSetBonus:
		'''
		Разбойные атаки будут с 5% высвобождать изумрудные вспышки из космоса, наносящие в 1,75 больше урона атаки
		Изумрудные вспышки наносят урон, равный урону атаки без критического удара
		При этом сами изумрудные вспышки могут наносить критические удары
		'''

	LeviathanHeart: {
		NormalTooltip:
			'''
			Увеличивает бонусное исцеление на 25%
			Исцеляющие заклинания будут давать бафф [rbuff:RagnarokMod/LeviathanHeartBubble] задетым игрокам
			'''
		CorruptTooltip:
			'''
			Пузыри Левиафан резонируют с тёмной энергией!
			Снижает расход здоровья на 1 ед.
			Использование здоровья на лучезарные заклинания будет давать бафф [rbuff:RagnarokMod/LeviathanHeartBubbleCorrupted]
			Увеличивает скорость лучезарных атак на 10%
			'''
	}
}

Compat: {
	TechPoints: Увеличивает максимальное число очков техники на
	Recharge: и перезарядку на
	BasicDamage: ед. базового урона
	DupeDamage: вашего разбойного урона будет наноситься повторно
	DupeCap: "Максимальное количество повторно нанесённого урона:"
	NoGuideStack: Этот эффект не суммируется с эффектами других руководств
	Power: % Сила
	Smited: был поражён.
	Darkness: свалился во тьму.
	TurnedToAmmo: был превращён в боеприпас.
	Recoil: не выдержал отдачи.
}

Items: {
	DrumStick: {
		DisplayName: Барабанная палочка
		Tooltip: "'Ваши враги теперь будут ещё и вашими барабанами!'"
	}

	AerospecBard: {
		DisplayName: Аэрофазовая выгнутая шляпа
		Tooltip:
			'''
			Увеличивает скорость игры на инструменте и восстановления вдохновения на 5%
			Увеличивает длительность симфонических усилений на 2 секунды
			'''
		SetBonus:
			'''
			Получение более 25 ед. урона за удар вызывает шквал самонаводящихся перьев
			Позволяет быстрее падать и защищает от урона при падении
			Увеличивает симфонический урон на 6%
			Увеличивает скорость передвижения на 7%
			'''
	}

	AerospecHealer: {
		DisplayName: Аэрофазовый капюшон
		Tooltip:
			'''
			Снижает весь урон, кроме лучезарного, на 10%
			Увеличивает лучезарный урон на 10%
			Увеличивает максимальный запас маны на 20 ед.
			'''
		SetBonus:
			'''
			Снижает весь урон, кроме лучезарного, на 10%
			Увеличивает лучезарный урон на 10%
			Получение более 25 ед. урона за удар вызывает шквал самонаводящихся перьев
			Позволяет быстрее падать и защищает от урона при падении
			Увеличивает бонусное исцеление на 2 ед. здоровья
			Увеличивает скорость передвижения на 10%
			'''
	}

	AuricTeslaFrilledHelmet: {
		DisplayName: Ауритовый воротниковый тесла-шлем
		DisplayNameEclipse: Первородный воротниковый тесла-шлем
		Tooltip:
			'''
			Увеличивает симфонический урон, шанс симфонического критического удара и скорость самонаведения духовых инструментов на 20%
			Увеличивает скорость передвижения на 5%
			Увеличивает скорость восстановления вдохновения на 30%
			Увеличивает максимальный запас вдохновения на 15 очков
			Снаряды струнных инструментов будут отскакивать 2 дополнительных раза
			'''
		SetBonus:
			'''
			Бонусы от комплектов брони барда: кровавой вспышки, богоубийцы и рапсода
			Нажатие клавиши «{$ThoriumMod.Keybinds.ArmorAbility.DisplayName}» активирует обе способности брони рапсода
			'''
		SetBonusHelheim: Бонусы от комплектов брони барда: эстрагоновой, кровавой вспышки и богоубийцы
	}

	AuricTeslaHealerHead: {
		DisplayName: Ауритовый озаряющий тесла-визор
		DisplayNameEclipse: Первородный озаряющий тесла-визор
		Tooltip:
			'''
			Усиливает некоторые лучезарные атаки тёмной энергией
			Увеличивает лучезарный урон на 100%
			Снижает весь урон, кроме лучезарного, на 80%
			Увеличивает шанс лучезарного критического удара на 25%
			Увеличивает скорость передвижения на 5%
			Снижает расход маны на 25%
			Увеличивает бонусное исцеление на 10 ед. здоровья
			Увеличивает максимальный запас маны на 100 ед.
			'''
		ToggleTooltip: "[c/aaaaaa:Нажмите Shift+ПКМ по этому предмету в инвентаре, чтобы переключить] [c/CC44FF:усиление тёмной энергией]"
		SetBonus:
			'''
			Бонусы от комплектов брони целителя: кровавой вспышки, Сильвы и ткача сновидений
			Нажатие клавиши «{$ThoriumMod.Keybinds.ArmorAbility.DisplayName}» активирует обе способности брони ткача сновидений
			Увеличивает лучезарный урон на 50%
			'''
		SetBonusHelheim:
			'''
			Бонусы от комплектов брони целителя: эстрагоновой, кровавой вспышки и Сильвы
			Увеличивает лучезарный урон на 50%
			'''
	}

	BlazingDrumBeat: {
		DisplayName: Изысканная барабанная палочка
		Tooltip:
			'''
			Удары в такт постепенно увеличивают урон и уровень усиления
			Удары не в такт значительно снижают эти бонусы и расходуют 9 ед. вдохновения
			Бонусы сохраняются при смене оружия, но постепенно ослабевают, пока это оружие не выбрано
			Выполнение более 2 последовательных ударов в такт высвобождает массивный язык пламени
			Язык пламени накладывает на всех в радиусе поражения дебафф [cbuff:CalamityMod/HolyFlames]
			'''
	}

	BloodflareHeadBard: {
		DisplayName: Обшипованный шлем кровавой вспышки
		Tooltip:
			'''
			Увеличивает симфонический урон и шанс симфонического критического удара на 20%
			Увеличивает скорость восстановления вдохновения на 15%
			Увеличивает максимальный запас вдохновения на 6 очков
			Увеличивает шанс выпадения нот вдохновения на 15%
			'''
		SetBonus:
			'''
			Симфонические атаки будут накладывать дебафф [cbuff:CalamityMod/BurningBlood]
			Вы будете накапливать очки кровожадности, по 2 очка за каждого поражённого симфоническим уроном врага (не чаще трёх раз в секунду)
			При достижении 100 очков увеличивает симфонический урон и шанс симфонического критического удара на 20%, а также скорость передвижения на 25%
			В дополнение увеличивает длительность усилений на 3 секунды и скорость восстановления вдохновения на 10%
			Нажатие клавиши «{$ThoriumMod.Keybinds.ArmorAbility.DisplayName}» потратит 20 очков кровожадности и взамен восстановит 10 вдохновения
			При получении урона у вас заберётся 25 очков
			Очки также будут стремительно пропадать, если не наносить урон более 5 секунд
			Ваши очки обнуляются во время появления босса
			'''
	}

	BloodflareHeadHealer: {
		DisplayName: Мрачный лик кровавой вспышки
		Tooltip:
			'''
			Снижает расход маны на 20%
			Снижает весь урон, кроме лучезарного, на 70%
			Увеличивает лучезарный урон на 50%
