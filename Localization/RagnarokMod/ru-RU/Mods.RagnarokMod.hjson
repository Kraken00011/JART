Buffs: {
	AntarcticCreativityBuff: {
		DisplayName: Антарктическая креативность
		Description: Мороз дарует вам невероятное вдохновение
		ItemTooltip: Увеличивает скорость восстановления вдохновения на 15% и игры на инструменте на 10%
	}

	AntarcticReinforcementBuff: {
		DisplayName: Антарктические укрепления
		Description: Мороз окутывает вас
		ItemTooltip: Увеличивает защиту на 8 ед. и бонусное исцеление на 2 ед.
	}

	AntarcticExhaustionDebuff: {
		DisplayName: Антарктическое изматывание
		Description: Мороз пробирает вас до костей
	}

	GuardianHealerBeamBuff: {
		DisplayName: Благословение стража-целительницы
		Description: На вас действует осквернённое благословение
		ItemTooltip: Увеличивает сопротивление урону на 10% и скорость регенерации здоровья на 5 ед./сек
	}

	ElementalScytheCooldown: {
		DisplayName: Перезарядка элементального жнеца
		Description: Элементальный жнец перезаряжается!
	}

	ScytheAirBuff: {
		DisplayName: Благословение воздуха
		Description: Ветер подталкивает вас
		ItemTooltip: Увеличивает скорость передвижения и время полёта на 20%
	}

	ScytheBrimstoneBuff: {
		DisplayName: Благословение серы
		Description: Ваши враги вспыхивают серным пламенем
		ItemTooltip: При попадании накладывает дебафф [cbuff:CalamityMod/BrimstoneFlames]
	}

	ScytheEarthBuff: {
		DisplayName: Благословение Земли
		Description: Земля защищает вас
		ItemTooltip: Увеличивает защиту на 10 ед.
	}

	ScytheOasisBuff: {
		DisplayName: Благословение оазиса
		Description: Оазис омолаживает вас
		ItemTooltip: Увеличивает скорость регенерации здоровья на 15 ед./сек
	}

	ScytheSandBuff: {
		DisplayName: Благословение песков
		Description: Пески усиливают вас
		ItemTooltip: Увеличивает урон на 5%
	}

	ScytheWaterBuff: {
		DisplayName: Благословение вод
		Description: Вода направляет ваши руки
		ItemTooltip: Увеличивает скорость атаки на 5%
	}

	AuricSurge: {
		DisplayName: Ауритовый всплеск
		Description: Вас поразила сила извне
	}

	KellyPetBuff: {
		DisplayName: Келли!
		Description: Келли следует за вами
	}

	NightfallenDebuff: {
		DisplayName: Сумрак
		Description: Тьма поглощает вас
