	ClientConfig: {
		DisplayName: Клиентская конфигурация

		Headers: {
			Audio: Звук
			UITweaks: Изменения интерфейса
			WelcomeText: Текст при заходе в мир
			Visual: Visuals
			VisFluxMeter: Vis Flux Meter Header
