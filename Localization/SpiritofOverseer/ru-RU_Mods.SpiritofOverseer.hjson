		ОЖИВШИЕ ОСТАНКИ
		ДРЕВНЯЯ ПТИЦА
		'''
	Atlas:
		'''
		ДЕРЖАТЕЛЬ НЕБОСВОДА
		АТЛАНТ
		'''
	Dusking:
		'''
		ДУХ ТЬМЫ
		СУМРАЧНЫЙ КОРОЛЬ
		'''
	Infernon:
		'''
		ОТВЕРГНУТЫЙ
		ИНФЕРНОН
		'''
	MoonWizard:
		'''
		ЧАРОДЕЙ СИНЕЙ ЛУНЫ
		ЛУННАЯ МЕДУЗА-ВОЛШЕБНИК
		'''
	ReachBoss:
		'''
		СТРАЖ-ПЕРЕРОСТОК
		ГНЕВОПЛЮЩ
		'''
	Scarabeus:
		'''
		СВЯЩЕННЫЙ ЖУК
		СКАРАБЕУС
		'''
	SteamRaiderHead:
		'''
		БЛУЖДАЮЩИЙ РАЗОРИТЕЛЬ
		ЗВЕЗДОПАНЦИРНЫЙ СТРАННИК
		'''
}

Configs: {
	ReworkConfig: {
		DisplayName: Клиентская конфигурация

		flash: {
			Label: Интенсивность вспышек света
			Tooltip: Устанавливает яркость вспышек света на экране.
		}

		overlay: {
			Label: Интенсивность эффектов экрана
			Tooltip: Устанавливает коэффициент прозрачности эффектов экрана.
		}

		seizures: {
			Label: Предупреждение о светочувствительности
			Tooltip: При заходе в мир будет выводиться сообщение, предупреждающее о большом количестве ярких вспышек, добавляемых модом.
		}
	}

	CompatConfig: {
		DisplayName: Конфигурация совместимости

		healthScale: {
			Label: Множитель здоровья боссов
			Tooltip: Умножает здоровье боссов из Spirit на указанное значение.
		}

		damageScale: {
			Label: Множитель урона боссов
			Tooltip: Умножает урон боссов из Spirit на указанное значение.
		}

		speedScale: {
			Label: Множитель скорости боссов
			Tooltip:
				'''
				Умножает скорость боссов из Spirit на указанное значение.
				Максимальное значение — 2, поскольку более высокие значения ломают поведение боссов.
				Для игры в режиме Инфернум рекомендуется значение 1,35.
				'''
		}

		itemReworks: {
			Label: Переработка некоторых предметов
			Tooltip:
				'''
				(Рекомендовано!)
				Перерабатывает некоторые предметы из Spirit, сильно улучшая их в визуальном и практическом плане.
				'''
		}

		spiramityBR: {
			Label: Боссы Spirit в Босс-раше Calamity
			Tooltip: Боссы Spirit будут появляться в Босс-раше из Calamity в порядке своей базовой прогрессии.
		}

		defenseDamage: {
			Label: Поддержка механики урона по защите
			Tooltip: 
				'''
				Позволяет некоторым атакам боссов из Spirit наносить урон по защите.
				Работает только с включённым Calamity Mod.
				'''
		}

		eternityModeOnly: {
			Label: Переработки только для режима Вечность
			Tooltip: Все переработки из мода будут только с включённым режимом Вечность.
		}
	}

	ReworkTogglesConfig: {
		DisplayName: Конфигурация переработок боссов

		voyager: {
			Label: "[i:SpiritMod/StarplateMask] Звездопанцирный странник"
			Tooltip: Включает переработку Звездопанцирного странника.
		}

		dusking: {
			Label: "[i:SpiritMod/DuskingMask] Сумрачный король"
			Tooltip: Включает переработку Сумрачного короля.
		}

		atlas: {
			Label: "[i:SpiritMod/AtlasMask] Атлант"
			Tooltip: Включает переработку Атланта.
		}
	}
}