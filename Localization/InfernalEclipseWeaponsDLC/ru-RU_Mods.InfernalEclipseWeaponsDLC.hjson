Items: {
	TwoPaths: {
		DisplayName: Две тропы
		Tooltip:
			'''
			Даёт 4 эссенции души при прямом попадании
			Нажмите ЛКМ, чтобы наносить полный урон по увеличенной площади
			Нажмите ПКМ, чтобы потратить немного маны и призвать белые косы, рассекающие врагов
			'''
	}

	TheParallel: {
		DisplayName: Параллель
		Tooltip:
			'''
			Выпускает каскад космических кинжалов из иного измерения
			После отскока от поверхности космические кинжалы войдут в осадное состояние
			Кинжалы, вошедшие в осадное состояние, будут некоторое время вращаться, тем самым заряжаясь
			Как только кинжал полностью зарядится, тот мгновенно броситься в направлении ближайшего врага, нанеся ему утроенный урон
			Одновременно в осадном состоянии может находится до 27 кинжалов
			Космические кинжалы, отскакивающие после этого, будут просто сразу же самонаводиться на ближайшего врага
			'''
	}

