			'''
	}

	AllSeersGlass: {
		DisplayName: Линза всевидящего
		Tooltip:
			'''
			Увеличивает шанс критического удара на 10%
			Увеличивает урон критических ударов
			Увеличивает максимальное количество стражей на 2
			Пассивно даёт усиленное приближение
			Усиление приближения можно отключить вместе с видимостью аксессуара
			Нажатие клавиши «{$Keybinds.AccessoryAbility.DisplayName}» остановит камеру на месте
			'Я вижу нерушимую крепостью в твоём будущем'
			'''
	}

	SwordofaThousandTruths: {
		DisplayName: Меч тысячи правд
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы взмахнуть мечом, восстанавливающим 7 ед. здоровья при попадании по врагу
			Удерживайте ПКМ, чтобы зарядить и бросить вонзающийся во врагов меч
			Когда меч вонзается, он начинает испускать светлую и тёмную энергию
			Светлая энергия самонаводится на ближайших союзников и исцеляет здоровье на величину, равную вашему бонусному исцелению
			Тёмная энергия самонаводится на ближайших врагов, нанося им урон
			Если бонусное исцеление игрока больше либо равно 5 ед., тёмная энергия начнёт накладывать различные на врагов различные ослабляющие дебаффы
			Одновременно можно бросить только 1 меч
			'Простите, свинюшки, но эта жертва крайне важна'
			'''
	}

	AbsoluteTVRemote: {
		DisplayName: Всевышний пульт от телевизора
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы вызвать ауру вокруг вас, замедляющую снаряды в определённом радиусе; можно использовать раз в 2 минуты
			Нажмите ПКМ, чтобы вызвать ауру вокруг вас, ускоряющую снаряды в определённом радиусе; можно использовать раз в 2 минуты
			Нажмите '{0}', чтобы выстрелить снарядом, останавливающим врагов на месте; можно использовать раз в 5 минут
			'Телевидение будет жить вечно!'
			'''
	}

	PlanetShaper: {
		DisplayName: Планеторез
		Tooltip:
			'''
			Вместо раскручивания коса взмахивает по диагонали
			Имеет комбо из 3 взмахов:
			    При каждом 1 взмахе коса стреляет 1 самонаводящимся огненным шаром и 2 лучами космической энергии
			    При каждом 2 взмахе коса стреляет 1 лучом космической энергии и 2 самонаводящимися огненными шарами
			    При каждом 3 взмахе коса прокручивается вокруг игрока
			Во время раскручивания коса выпускает до 6 самонаводящихся огненных шаров и лучей космической энергии
			Коса и огненные шары игнорируют 125 ед. защиты и накладывают дебафф [cbuff:CalamityMod/Dragonfire]
			Лучи космической энергии игнорируют 75 ед. защиты и накладывают дебаффы [cbuff:CalamityMod/ElementalMix] и «Астральная зараза»
			'ДАМЫ И ГОСПОДА... ДА БУДЕТ РОК, ДА БУДЕТ РОК, ДА БУДЕТ РОК!!!'
			'''
	}

	GodsPitch: {
		DisplayName: Божественный звук
		Tooltip:
			'''
			Увеличивает максимальный запас вдохновения на 5 очков
			Увеличивает симфонический урон на 15%
			Симфонические усиления длятся на 3 секунды дольше
			Увеличивает уровень накладываемых усилений себе и всем союзникам на 2
			Увеличивает радиус действия усилений
			Атаки инструментами запускают падающие сверху вниз трубы
			[c/FF232C:Звуки, издаваемые трубами, могут показаться довольно неприятными, пугающими или даже отталкивающими]
			'Ваши уши недостойны слышать нечто подобное...'
			'''
	}

	GauntletofAnnihilationVoid: {
		DisplayName: "{$Items.GauntletofAnnihilation.DisplayName}"
		Tooltip: "{$Items.GauntletofAnnihilation.Tooltip}"
	}

	GauntletofAnnihilation: {
		DisplayName: Рукавица изничтожения
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы выпустить каскад из 4 космических рукавиц, накладывающих дебафф [cbuff:CalamityMod/GodSlayerInferno]
			Нажмите ПКМ, чтобы начать выпускать стремительные удары космической энергии, проталкивающие вас вперёд в направлении курсора
			Во время проталкивания вас может отбросить назад при столкновении с чем-либо
			Нажатие ЛКМ не более чем через 3 кадра после получения урона выпустит рукавицу богоубийцы
			Рукавица богоубийцы всегда наносит критический урон и накладывает дебафф [cbuff:CalamityMod/WhisperingDeath]
			Становится источником света, если отмечена как «Избранное»
			'''
	}

	BlightedBadge: {
		DisplayName: Прогнившая эмблема
		Tooltip:
			'''
			Удары истинного ближнего боя вызывают падение астральных звёзд с небес
			Атакующие ошеломляются, получая огромный урон
			При получении урона кратковременно значительно увеличивает скорость атаки и шанс критического удара ближнего боя,
			а также вызывает взрыв и временно увеличивает урон истинного ближнего боя на 30%
			Длительность усилений зависит от количества полученного урона, вплоть до 10 секунд
			Даёт невосприимчивость к дебаффу [cbuff:CalamityMod/AstralInfectionDebuff]
			'''
	}

	ImagiknightHeraldry: {
		DisplayName: Вестничество Imagiknight
		Tooltip:
			'''
			Множитель урона зависит от того, на сколько близко вы находитесь к врагам
			Максимальный бонус к урону: 20%
			Излучает пылающую ауру, увеличивающую урон ближайшим союзникам
			Чем ближе союзники к вам, тем больше увеличивается их множитель урона
			Эти множители не суммируются с множителями [i:CalamityMod/WarbanneroftheRighteous] Боевого знамя праведных; если оба предмета надеты, будет использоваться наибольший из имеющихся множителей
			Эффекты становятся более прозрачными и беззвучными, если отображение аксессуара отключено
			Увеличивает всем союзникам регенерацию здоровья на {0} ед./сек, максимальный запас здоровья на {1}%, сопротивление урону на {2}%, защиту на {3} ед. и урон на {4}%
			'Идея - простая частичка, прогрессивно ускоряющаяся соразмерно количеству прошедших сквозь неё умов
			Если вам удастся собрать достаточное количество умов вместе, они смогут сделать названную идею неостановимой' -Imagiknight_Parad0xical
			'''
	}

	VibrantShield: {
		DisplayName: Вибрантовый щит
		Tooltip:
			'''
			Увеличивает максимальный запас пустоты на 25 ед.
			Постепенно генерирует до 15 ед. жизненного щита
			'''
	}

	DivineAxe: {
		DisplayName: Божественная секира
		Tooltip:
			'''
			Взмахивает медленной и очень тяжёлой секирой, накладывающей дебафф [cbuff:CalamityMod/HolyFlames]
			При прямом попадании вызывает звездообразный взрыв, дополнительно накладывающий дебафф [cbuff:Daybreak]
			Нажатие ПКМ призывает над вами светило и при продолжении удерживания ПКМ секира начнёт колоть его, заставляя светило выпускать мощные ударные волны
			Ударные волны накладывают дебафф [cbuff:Daybreak]
			'''
	}

	AncientSteelShield: {
		DisplayName: Щит из древней стали
		Tooltip:
			'''
			Постепенно генерирует до 20 ед. жизненного щита
			При получении урона накладывает на атакующего бессрочное суммирующееся проклятие кровотечения, наносящее по 5 ед. урона в секунду
			Этот шанс увеличивается в зависимости от шанса критического удара у вашего оружия
			'''
	}

	DoubleFlail: {
		DisplayName: Двойной цеп-ядро
		Tooltip:
			'''
			75% базового урона
			Если первый удар по врагу был совершён любым цепным оружием, то это оружие гарантировано выпустит либо серный, либо метельный шипастый шар
			Последующие удары цепным оружием также могут с определённым шансом выпустить дополнительные либо серные, либо метельные шипастые шары
			Серный шипастый шар накладывает на врагов дебафф [cbuff:CalamityMod/BrimstoneFlames] и иногда может дать игроку бафф [cbuff:InfernalEclipseWeaponsDLC/HotFlailDmg]
			Метельный шипастый шар накладывает на врагов дебафф [cbuff:Frostburn2] и иногда может дать игроку бафф [cbuff:InfernalEclipseWeaponsDLC/ColdFlailDefense]
			'''
	}

	PerfectPurple: {
		DisplayName: Цеп-ядро космического совершенства
		Tooltip:
			'''
			100% базового урона
			Если первый удар по врагу был совершён любым цепным оружием, то это оружие гарантировано выпустит совершенный шипастый шар
			Последующие удары цепным оружием также могут с определённым шансом выпустить дополнительные совершенный шипастые шары
			Совершенный шипастый шар накладывает на врагов дебафф [cbuff:CalamityMod/GodSlayerInferno] и иногда может дать игроку бафф [cbuff:InfernalEclipseWeaponsDLC/PerfectFlailBuff]
			'''
	}

	BlackHoleFlail: {
		DisplayName: Цеп-ядро чёрной дыры
		Tooltip:
			'''
			300% базового урона
			Цепное оружие может выпустить чёрную дыру, самонаводящуюся на врагов и затягивающую их внутрь себя
			Чёрная дыра может наложить на врагов дебафф [cbuff:CalamityMod/WitherDebuff]
			'Знаешь, а ведь это не должно работать так, как работает сейчас. Чёрная дыра таких размеров может с лёгкостью поглотить нашу планету... но мне кажется, лучше нам не задаваться такими вопросами'
			'''
	}

	PerennialShield: {
		DisplayName: Многолетний щит
		Tooltip:
			'''
			Постепенно генерирует до 50 ед. жизненного щита
			Даёт дополнительные эффекты в зависимости от того, какой шлем разорителя на вас надет:
			    [i:CalamityMod/ReaverHeadTank]: Увеличивает максимальный запас здоровья 15 ед. и сопротивление урону на 10%
			    [i:CalamityMod/ReaverHeadMobility]: Увеличивает скорость передвижения на 10%, а также позволяет совершать таранящий рывок
			    [i:CalamityMod/ReaverHeadExplore]: Увеличивает скорость прыжка на 20% и даёт невосприимчивость к урону от падения
			'''
	}

	HolyFlail: {
		DisplayName: Осквернённый цеп-ядро
		Tooltip:
			'''
			100% базового урона
			Если первый удар по врагу был совершён любым цепным оружием, то это оружие гарантировано выпустит осквернённый шипастый шар
			Последующие удары цепным оружием также могут с определённым шансом выпустить дополнительные осквернённые шипастые шары
			Осквернённые шипастые шары накладывают дебафф [cbuff:CalamityMod/HolyFlames], а также иногда при попадании выпускают святые огни
			'''
	}

	TerraSheath: {
		DisplayName: Терра-ножны
		Tooltip:
			'''
			Если держать меч и не использовать его в течение {1} {^1:секунды;секунд}, то при следующей атаке он выпустит {0} самонаводящихся терра-сфер
			При попадании по врагу терра-сферы восстанавливают 3% от вашего недостающего здоровья
			'''
	}

	BlazeScourgeBag: {
		DisplayName: Сумка пылающего бича
		Tooltip:
			'''
			Позволяет мастерски овладеть искусством йо-йо
			Второе йо-йо наносит на 50% меньше урона
			Атаки йо-йо накладывают дебафф [cbuff:CalamityMod/HolyFlames], а также могут с определённым шансом дополнительно наложить ещё один дебафф [cbuff:InfernalEclipseWeaponsDLC/LimbBurn]
			При нанесении урона врагу йо-йо увеличивает сопротивление урону на 10% до тех пор, пока вы не его не получите
			Этот эффект перезаряжается в течение 15 секунд после получения урона
			'''
	}
}

ItemTooltip: {
	DuesFluteLore: Они обнаружили источник астральной инфекции и в попытке уничтожить его применили звёздное ядро к заражённому алтарю
	DuesFluteLore2: Однако алтарь отреагировал неожиданно... два огонька начали отталкиваться друг от друга, устремляясь в небо и открыв над ним разлом
	DuesFluteLore3: То, что вышло из него, поистине было не от мира сего, но их восхищению не суждено было продлиться - слуга звёзд бросился на них
	UniversalLore1: Кос принял свой последний бой. Израсходовал все свои козыри. Он проиграл им. Однако это не значило, что Затмение навсегда погасло
	UniversalLore2: Используя всю оставшуюся силу, что таилась в его душе, он призвал истинного богоубийцу: Пожирателя богов
	ParallelLore1: Как он и ожидал, они убили Штормового ткача. Но у Коса был припасен еще один туз в рукаве
	ParallelLore2: Внезапно, безо всякого предупреждения, Кос переместил всех в зазеркалье и призвал своего второго слугу: Сигнуса
	TwoSideLore1: Они преодолели Рагнарёк, уничтожили Затмение, пережили муссон слизи,
	TwoSideLore2: даже стояли на границе вечности, но лишь тогда Рен спросил их: «Какой путь вы изберёте?»
	NeonRipperLore1: После поражения Голиаф Эрелиан решил переработать часть броневых пластин, что тот носил
	NeonRipperLore2: Так он создал два оружия: Первым стала коса, способная поглощать ауру, подобно способности Ками
	PBGBardALore2: Так он создал два оружия: Вторым стала гитара, выпускающая разноцветные микроволны
	SearingSpearTip: 150% базового урона
	ArcticSpearTip: 115% базового урона
	DoubleFlailLore:
		'''
		Каламитас и Пермафросту всегда удавалось хорошо работать в тандеме, как ученик с учителем, когда она ещё была юна
		Эти два цепа используют те же техники, чтобы совмещать лёд и пламя методами, губительными для ваших врагов
		'''
	PerfectPurpleLore:
		'''
		Но всё же, совершенен он не был
		У командной работы есть свои пределы
		В конце-концов, вашим лучшим другом для себя являетесь вы сами
		Лишь вместе с самим собой можно добиться гораздо большего, ведь...
		Именно в гармонии с самим собой вы становитесь по-настоящему совершенны
		'''
	VerveineItem: "'Предмет, благословлённый орхидеей...'"
	EngineGatling:
		'''
		Режим пулемёта:
		Удерживайте ЛКМ, чтобы значительно снизить разброс оружия и увеличить скорость атаки до максимума
		Выстрелы могут пронзать до 4 врагов
		'''
	EngineGatlingMode: ПУЛЕМЁТ
	EngineLaser:
		'''
		Режим лазера:
		Стреляет бесконечно пронзающим лазером, оставляющим наносящий урон шлейф
		Лазер может отскакивать от блоков до 3 раз
		'''
	EngineLaserMode: ЛАЗЕР
	EngineTheBigOne:
		'''
		Режим «Большой малый»:
		Стреляет колоссальной сферой концентрированной энергии, взрывающейся через определённое время
		Чем ближе враг к центру взрыва, тем больше урона он получит
		Одновременно может существовать только 1 «большой малый»
		'''
	EngineTheBigOneMode: БОЛЬШОЙ МАЛЫЙ
	Playtester: - Предмет тестировщика -
	Contributor: - Предмет участника -
	Donor: - Предмет покровителя -
	DedTo: - Посвящается {0} -

	Dedicated: {
