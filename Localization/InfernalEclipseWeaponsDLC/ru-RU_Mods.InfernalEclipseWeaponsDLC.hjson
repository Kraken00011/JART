			Увеличивает шанс выпадения нот вдохновения на 10%
			Симфонические усиления длятся на 3 секунды дольше
			'''
	}

	NecrosingerSkull: {
		DisplayName: Череп некропева
		Tooltip:
			'''
			Увеличивает урон призывателя, а также симфонический и пустотный урон на 20%
			Увеличивает скорость хлыстов и симфонической игры на 10%
			Увеличивает получаемое количество пустоты на 4 ед. и её максимальный запас на 125 ед.
			Увеличивает скорость восстановления вдохновения на 15%
