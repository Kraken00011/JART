		Tooltip: "{$CommonItemTooltip.BannerBonus}{$NPCs.WulfrumRepairUnit.DisplayName}"
	}

	SpringCoil: {
		DisplayName: Пружина
		Tooltip: "'ЭТОТ ПРЕДМЕТ СЕЙЧАС НЕ ДОСТУПЕН, ПОСКОЛЬКУ БОСС С КОТОРОГО ЭТОТ ПРЕДМЕТ ВЫПАДАЕТ ЕЩЁ НЕ БЫЛ ДОБАВЛЕН'"
	}

	OverchargedBattery: {
		DisplayName: Перегруженный аккумулятор
		Tooltip: ""
	}
}

