	}

	ReactivePlatingCooldown: {
		DisplayName: Электрический перегруз!
		Description: Реактивная пластина на перезарядке
	}

	MetalashTagBuff: {
		DisplayName: Метка металлохлёста
		Description: Получаемый урон от миньонов увеличен
	}
}

