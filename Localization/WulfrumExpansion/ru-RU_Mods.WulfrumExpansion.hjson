		Tooltip: ""
	}

	WulfrumHaulerBanner: {
		DisplayName: Знамя вульфрумового перевозчика
		Tooltip: "{$CommonItemTooltip.BannerBonus}{$NPCs.WulfrumHauler.DisplayName}"
	}

	WulfrumSpringerBanner: {
