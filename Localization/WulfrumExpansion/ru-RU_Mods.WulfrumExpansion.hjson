Buffs: {
	ReactivePlatingBuff: {
		DisplayName: Электрическая реакция!
		Description: Урон и защита увеличены
	}

	ReactivePlatingCooldown: {
		DisplayName: Электрический перегруз!
		Description: Реактивная пластина на перезарядке
	}

	MetalashTagBuff: {
		DisplayName: Метка металлохлёста
		Description: Получаемый урон от миньонов увеличен
	}
}

Configs: {
	WulfrumExpansionConfig: {
		DisplayName: Конфигурация Calamity Overdrive

		Headers: {
			Visuals: Внешний вид
			BossIntros: Совместимость
		}

		UseAlternateRelicTexture: {
			Label: Цветная реликвия
			Tooltip: Заменяет текстуру Вульфрумового Прототанка на окрашенную версия.
		}

		EnableScreenShake: {
			Label: Тряска экрана
			Tooltip: Включает/Выключает использование тряски экрана во время событий по типу отчёта в осаде металлолома.
		}

		BossIntroScreens: {
			Label: Вступительные анимации для Infernum
			Tooltip:
				'''
				Включает/Выключает отображение вступительных анимаций в стиле Infernum для боссов Calamity Overdrive.
				Для работы требует Infernum Mode.
				'''
		}

		EnableAmalgamationInfernumIntro: {
			Label: Вступительные анимации для Infernum
			Tooltip:
				'''
				Включает/Выключает отображение вступительных анимаций в стиле Infernum для боссов Calamity Overdrive.
				Для работы требует Infernum Mode.
				'''
		}
	}
}

Events: {
	ScrapRush: {
		DisplayName: Осада металлолома
		SpawnInfo: Используйте [i:WulfrumExpansion/SignalInterceptor] или уничтожьте вульфрумовый пилон на поверхности.
	}
}

InfernumIntros.Amalgamation:
	'''
	НАГРОМОЖДЕНИЕ МЕТАЛЛОЛОМА
	ВУЛЬФРУМОВЫЙ ПРОТОТАНК
	'''

Items: {
	WulfrumSword: {
		DisplayName: Мечтололом
		Tooltip:
			'''
			Стреляет вульфрумовой шрапнелью, остающейся на поверхности
			Шрапнель наносит контактный урон всем врагам, которые прошлись по ней
			[c/83B87E:'Побитый ржавый клинок, выкованный в качестве одного из базовых видов оружия для наших воинов']
			[c/83B87E:'Такие клинки выходили крайне дешёвыми, но очень хлипкими, из-за чего часто ломались в битвах']
			[c/83B87E:'Забавно, что, похоже, эти обломки скорее помогали нам в битвах, нежели мешали им']
			'''
	}

	WulfrumSapper: {
		DisplayName: Энерговыжималка
		Tooltip:
			'''
			Стреляет пробивающими энергетическими зарядами
			На каждые 50 выстрелов расходует 1 [i:CalamityMod/EnergyCore] энергетическое ядро
			[c/83B87E:'Изначально энерговыжималки задумывались как один из видов штатного вооружения для каждого из наших солдат']
			[c/83B87E:'Однако исполнение этих дешёвых пестиков оставляло желать лучшего, а производство пуль для них было слишком дорогим']
			[c/83B87E:'К счастью, наши новомодные электросистемы решили эти проблемы, спасши это оружие от утилизации']
			'''
	}

	ArcScepter: {
		DisplayName: Дуговой скипетр
		Tooltip:
			'''
			Стреляет непрерывным лучом энергии
			Удерживайте ЛКМ, чтобы постепенно увеличивать его длину, но снижать урон
			[c/83B87E:'Энергетические ядра, хранящиеся в сердце каждого автоматона, играют важную роль в их поразительной силе']
			[c/83B87E:'Я и мои помощники-инженеры смогли обуздать энергию чистейшей плазмы и электричества, чтобы создавать эти ядра в промышленных масштабах']
			[c/83B87E:'Будучи настоящим чудом техники, они являются одним из главных компонентов, поддерживающих жизнь в каждом из наших удивительных механизмов']
			'''
	}

	Metalash: {
		DisplayName: Металлохлёст
		Tooltip:
			'''
			При попадании по врагу вонзает в него вульфрумовый кинжал
			Пока вонзён во врага, кинжал наносит постоянный урон
			Одновременно во врага может быть вонзён только 1 кинжал
			[c/83B87E:'Веревочный хлыст, смастерённый из чистой плазмы, с прикреплённым на его конце ржавым кинжалом']
			[c/83B87E:'Один из наших самых амбициозных проектов, оправдавших ожидания, - весьма полезное многофункциональное оружие']
			[c/83B87E:'Один хороший удар от этого малыша - и твой враг будет молить о пощаде и бежать плакаться к своей мамочке!']
			'''
	}

	Cablastitor: {
		DisplayName: Кабумсатор
		Tooltip:
			'''
			Стреляет перегруженным конденсатором, испускающим электродугу в воздухе перед падением
			Не наносит контактного урона, но может взорваться при столкновении с поверхностью
			При скрытном ударе увеличивает радиус взрыва и накладывает дебафф [cbuff:CalamityMod/StaticDischarge] на всех врагов в радиусе взрыва
			[c/83B87E:'Перегрузи конденсатор, и вместо накапливания энергии он начнёт пытаться отдавать её']
			[c/83B87E:'Однако мы так и не смогли узнать, как управлять такой реакцией']
			[c/83B87E:'Да к чёрту, зачем это нам, когда ты можешь просто взять и бросить эту хрень!']
			'''
	}

	WulfrumChainsaw: {
		DisplayName: Вульфрумовая бензопила
		Tooltip: ""
	}

	WulfrumHealthKit: {
		DisplayName: Вульфрумовая аптечка
		Tooltip:
			'''
			Сокращает время действия всех наложенных на игрока дебаффов в 2 раза
			'Ни о какой стерилизации и речи не идёт'
			'''
	}

	WulfrumShield: {
		DisplayName: Вульфрумовый щит
		Tooltip: ""
	}

	ElectricalShield: {
		DisplayName: Электрический щит
		Tooltip:
			'''
			Даёт 35% шанс наложить дебафф [cbuff:CalamityMod/StaticDischarge] на любого атакующего вас врага
			[c/83B87E:'Модернизированная версия обычного щита, напичканная собранными электроузлами']
			[c/83B87E:'Дополнительный заряд значит, что теперь щит может сам сможет «дать сдачи» при необходимости!']
			'''
	}

	ReactivePlating: {
		DisplayName: Реактивная пластина
		Tooltip:
			'''
			Получение более 50 ед. урона единовременно на 8 секунд увеличивает урон и защиту на 6 ед., а также немного скорость передвижения
			Имеет 20 секунд перезарядки
			Эксперт
			'''
	}

	SignalInterceptor: {
		DisplayName: Портативный испускатель частот
		Tooltip:
			'''
			Использование этого предмета позволяет включить или отключить появление вульфрумовых пилонов в вашем мире
			Нажмите ПКМ, чтобы переключить эффект
			[STATE]
			Используйте, чтобы выдать сигнал, приманивающий орды вульфрумовых автоматонов к вам
			[c/83B87E:'Мы зовём его П.И.Ч.']
			'''
		StateOn: "[c/83B87E:Вульфрумовые пилоны не могут появиться]"
		StateOff: "[c/FF6A1A:Вульфрумовые пилоны могут появиться]"
	}

	WulfrumRadio: {
		DisplayName: Вульфрумовое радио
		Tooltip:
			'''
			Призывает Вульфрумовый прототанк
			Не расходуется
			'При встряхивании может источать сигналы на необычных частотах'
			'''
	}

	WulfrumCircuitry: {
		DisplayName: Электроузел
		Tooltip: "'Шокирующе!'"
	}

	SystematicDefianceMusicBox: {
		DisplayName: Музыкальная шкатулка (Осада металлолома)
		Tooltip: Проигрывает «Systematic Defiance» за авторством Brimstone Premium
	}

	WulfrumAmalgamationBag: {
		DisplayName: Мешок с сокровищами (Вульфрумовый прототанк)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	WulfrumAmalgamationLore: {
		DisplayName: История (Вульфрумовый прототанк)
		Tooltip: "{$Mods.CalamityMod.Items.Lore.ShortTooltip}"
		Lore:
			'''
			Творение вульфрумового сопротивления, это жалкое нагромождение довольно грубо сваренного между собой вульфрумового металла никогда не должно участвовать в реальных битвах
			Его арсенал на текущем этапе вообще недоделан, а его движения крайне беспорядочны
			Это мерзкое создание, называющееся «танком» и секунды бы протянуло в схватке со мной
			Но всё же, эта машина сумела пережить окончательное уничтожение сил сопротивления, произошедшее скорее не от их собственной силы, а банальной трусости
			Брошенная собственными создателями, эта машина всё ещё может пробудиться от своего вечного сна теми самыми частотами, которыми раньше её вызывали для прохождения ежедневных испытаний
			'''
	}

	WulfrumRebellionLore: {
		DisplayName: История (Вульфрумовое сопротивление)
		Tooltip: "{$Mods.CalamityMod.Items.Lore.ShortTooltip}"
		Lore:
			'''
			Во время моих завоеваний теперь уже известное вульфрумовое сопротивление начало расти
			Это «сопротивление» доставляло лишь незначительные неудобства, но в будущем могло перерасти в куда более серьёзную проблему
			Пока я поначалу не воспринимал их движение всерьёз, Дрэйдон заинтересовался их энергетическим вооружением, которое было довольно эффективным
			Это привело к поимке Вульфрумового корабля-носителя, отправленного уничтожить тех, кто его и создали
			'''
	}

	PlasmaCore: {
		DisplayName: Плазменное ядро
		Tooltip:
			'''
			'ЭТОТ ПРЕДМЕТ СЕЙЧАС НЕ ДОСТУПЕН, ПОСКОЛЬКУ БОСС С КОТОРОГО ЭТОТ ПРЕДМЕТ ВЫПАДАЕТ ЕЩЁ НЕ БЫЛ ДОБАВЛЕН'
			Увеличивает защиту на 5 ед.
			Даёт энергетический щит, поглощающий получаемый урон
			Щит перезаряжается в течении 4 секунд без получения урона
			'''
	}

	WulfrumVoicebox: {
		DisplayName: Поношенный голосовой аппарат
		Tooltip:
			'''
			[c/83B87E:'АЗШАПЗ ПИТРВФ ХЗАПЩАРА, БУБ ХЩЗАФ ШАХЗПРТАФФ']
			[c/83B87E:'.....чего?']
			'''
	}

	AmalgamationTrophy: {
