Items: {
	AtomSplitter: {
		DisplayName: Атомный расщепитель
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы бросить радиоактивный топорик, пронзающий бесконечное количество врагов
			Нажмите ПКМ, чтобы разместить нестабильное ядро в точке курсора
			Только 1 нестабильное ядро можно разместить одновременно
			При попадании по ядру любым метательным снарядом тот разделит его на 3
			Если поблизости находятся враги, при разделении снаряды наведутся на них
			В дополнение, ядро разделяется на 2 самонаводящихся стабильных изотопа
			'Ядерное расщепление!'
			'''
	}

	BlackPlague: {
		DisplayName: Чёрная смерть
		Tooltip:
			'''
			Вращает заражающую косу, накладывающую на врагов дебафф «{$BuffName.Poisoned}»
			Периодически высвобождает лучи заражения
			'''
	}

	CrusadersWarHorn: {
		DisplayName: Боевой рог крестоносца
		Tooltip:
			'''
			Стреляет прыгучими сферами света
			'За землю святую!'
			'''
	}

	CursedSporeKnife: {
		DisplayName: Проклятый споровый клинок
		Tooltip:
			'''
			Бросает отравленный клинок средней дальности
			При нанесении критического удара высвобождает небольшое облако токсичных спор
			'''
	}

	EaglecrestTambourine: {
		DisplayName: Бубен Клювогорья
		Tooltip:
			'''
			Удерживайте ЛКМ, чтобы играть на бубне, тем самым заряжая его
			Зарядка оружия может увеличить урон бубна вплоть до 1000%
			Отпустите ЛКМ, чтобы бросить его
			'''
	}

	EaglecrestTomahawk: {
		DisplayName: Томагавк Клювогорья
		Tooltip:
			'''
			Бросает земляной подверженный гравитации томагавк
			При попадании вызывает взрыв
			Чем дольше будет падать томагавк, тем больше урона он нанесёт (до 600%)
			Этот множитель работает только при прямых попадания по врагу
			'Заруби себе на носу: Здесь я диктую правила!'
			'''
	}

	EMStabber: {
		DisplayName: Э.М. Протыкатель
		Tooltip:
			'''
			При попадании вонзается во врага
			(6[i:Redemption/EnergyCell]) Перегружает ваши ножи
			Пока перегруженные ножи находятся во враге, они будут источать наносящие урон электромагнитные поля
			Не требует наличия Энергоячейки в инвентаре
			'''
	}

	GroomsGift: {
		DisplayName: Дар Грум
		Tooltip:
			'''
			Высвобождает слабо самонаводящийся дух
			'Никто не знает, что это такое, но все знают, что это одна из её особо ценных вещиц'
			'''
	}

	HalfLife: {
		DisplayName: Сталкер
		Tooltip:
			'''
			Вместо вращения совершает взмахи по диагонали
			Каждый 1-2 взмах высвобождает шквал альфа-частиц в направлении курсора
			Альфа-частицы не пронзают врагов, но кратковременно застревают в них, нанося дополнительный урон
			Каждый 3 взмах коса раскручивается вокруг вас и выбрасывает множество бета-частиц в разные стороны
			Бета-частицы пронзают врагов и проходят сквозь блоки, но наносят меньше урона
			'Сталкера коса кормит!'
			'''
	}

	HardlightMask: {
		DisplayName: Твёрдосветовая маска
		Tooltip:
			'''
			Снижает весь урон, кроме лучезарного, на 33%
			Увеличивает лучезарный урон на 13%
			Увеличивает шанс лучезарного критического удара на 10%
			Исцеляющие заклинания восстанавливают дополнительно 6 единиц здоровья
			'''
		SetBonus:
			'''
			Призывает дронов-починщиков, исцеляющих игроков с наименьшим здоровьем
			Дроны-починщики восстанавливают здоровье на величину, равную 10x бонусного исцеления
			'''
	}

	HardlightReticle: {
		DisplayName: Твёрдосветовой прицел
		Tooltip:
			'''
			Увеличивает метательный урон на 13%
			Даёт 33% шанс не потратить метательный предмет
			Увеличивает максимальное число очков техники на 2
			'''
		SetBonus: Призывает орбитальную бомбардировку рядом с игроком
	}

	HardlightVisage: {
		DisplayName: Твёрдосветовой лик
		Tooltip:
			'''
			Увеличивает симфонический урон на 13%
			Увеличивает скорость симфонической игры на 7%
			Увеличивает максимальный запас вдохновения на 4 очка
			Увеличивает время действия усилений на 2 секунды
			'''
		SetBonus:
			'''
			Проигрывает отвлекающий дроп, дающий усиление Вариативность I
			В дополнение, также стремительно восстанавливает до 40 очков вдохновения
			'''
	}

	HauntedGramophone: {
		DisplayName: Зловещий граммофон
		Tooltip:
			'''
			Проигрывает зловещий шум, накладывающий на врагов дебафф «{$ThoriumMod.Buffs.Tuned.DisplayName}»
			Нажмите ПКМ, чтобы проигрывать шум во все стороны
			Враги с дебаффом «{$ThoriumMod.Buffs.Tuned.DisplayName}» получают на 5% больше урона
			'Жуть какая, он даже звуки сам собой воспроизводит'
			'''
	}

	HolyChalice: {
		DisplayName: Чаша святой воды
		Tooltip:
			'''
			Разбрызгивает капли святой воды
			'Тфвоя душа будет оцфифена!'
			'''
	}

	IonWind: {
		DisplayName: Ионный ветер
		Tooltip:
			'''
			Стреляет самонаводящимся ионизированныи ветром
			Ионизированный ветер терзает поражённых врагов
			Расходует энергию ([i:Redemption/EnergyCell]) на величину, равную потраченному на атаку вдохновению
			Требуется наличие Энергоячейки в инвентаре
			'''
	}

	KillswitchEngineer: {
		DisplayName: Убильник
		Tooltip:
			'''
			Вместо вращения совершает взмахи по диагонали
			Пока в вашем инвентаре находится Энергоячейка, коса будет:
			При наличии любого процента заряда каждый 1 взмах выпускать обжигающие ударные волны, а вторым каскады самонаводящихся снарядов
			При заряде выше 33% снаряды косы будут вызывать дополнительные разрезы в движении
			При заряде ниже 33% прямые попадания и ударные волны будут заряжать вашу Энергоячейку на величину, равную получаемому количеству эссенций души
			Расходует энергию ([i:Redemption/EnergyCell]) на величину, равную получаемому количеству эссенций души
			'''
	}

	LeafLyre: {
		DisplayName: Лира листофила
		Tooltip: Стреляет маленькими рассекающими листками
	}

	Milkomeda: {
		DisplayName: Млечномеда
		Tooltip:
			'''
			Бросает 2 космических чакрама, которые со временем начинают сталкиваться друг с другом
			При каждом столкновении высвобождает множество самонаводящихся звёзд
			'Прекрасный танец, длящийся вот уже более двух миллиардов лет, символизирует слияние двух величественных галактик'
			'''
	}

	MutagenBard: {
		DisplayName: Мутаген барда
		Tooltip:
			'''
			Увеличивает симфонический урон на 15%
			Увеличивает шанс симфонического критического удара на 10%
			Увеличивает максимальный запас вдохновения на 4 очка
			'''
	}

	MutagenHealer: {
		DisplayName: Мутаген целителя
		Tooltip:
			'''
			Увеличивает лучезарный урон на 15%
			Увеличивает шанс лучезарного критического удара на 10%
			Исцеляющие заклинания восстанавливают дополнительно 2 ед. здоровья
			'''
	}

	MutagenThrower: {
		DisplayName: Мутаген ниндзя
		Tooltip:
			'''
			Увеличивает метательный урон на 15%
			Увеличивает шанс метательного критического удара на 10%
			Увеличивает максимальное число очков техники на 1
			'''
	}

	NoceboEffect: {
		DisplayName: Эффект ноцебо
		Tooltip:
			'''
			Инъецирует смертельный вирус в поражённых врагов
			'Больно не будет! (Больно будет, ещё как будет...)'
			'''
	}

	Oboeterator: {
		DisplayName: Гобойлитератор
		Tooltip:
			'''
			Одновременно считается и электронным, и духовым инструментом
			При заряде выше 57% начинает стрелять сверхскоростными молниями, наносящими 50% урона {$Redemption.Items.Thunder.DisplayName}
			Молнии получают возможность нацеливаться на врагов от бонусов к скорости и дальности нацеливания духовых инструментов
			Критически удары молниями возвращают 1 очко вдохновения
			При заряде ниже 56% вместо молний будут выпускаться плазменные заряды, наносящие урон {$Redemption.Items.Fire.DisplayName}
			Нанесение критических ударов плазменными снарядами заряжает вашу Энергоячейку
			Расходует энергию ([i:Redemption/EnergyCell]) на величину, равную потраченному на атаку вдохновению
			Требуется наличие Энергоячейки в инвентаре
			'Облитерирует барабанные перепонки ваших бедных врагов'
			'''
	}

	OmegaDefibrillator: {
		DisplayName: Омега-дефибриллятор
		Tooltip:
			'''
			(2[i:Redemption/EnergyCell]) Высвобождает мощные самонаводящиеся электромагнитные лучи, способные как наносить урон, так и исцелять союзников
			Одна атака может взаимодействовать с 3 врагами или союзниками одновременно, но враги всегда будут иметь больший приоритет
			При попадании по союзнику исцеляет их и восстанавливает заряд (1[i:Redemption/EnergyCell]) соразмерно количеству исцелённых союзников
			При попадании по врагу наносит ему урон несколько раз подряд и восстанавливает заряд (1[i:Redemption/EnergyCell]) при нанесении критических ударов
			Требуется наличие Энергоячейки в инвентаре
			'Восстанови сердцебиение своего союзника... остановив вражеское'
			'''
	}

	RadiumGuitar: {
		DisplayName: Радиевая гитара
		Tooltip:
			'''
			Выпускает сконцентрированные лучи гамма-излучения в направлении курсора
			Излучение будет оставаться на врагах в течении небольшого количества времени
			'Тяжёлый технорок!'
			'''
	}

	RendingCoil: {
		DisplayName: Кромсающий виток
		Tooltip:
			'''
			Вместо вращения совершает взмахи по диагонали
			Пока в вашем инвентаре находится Энергоячейка, коса будет:
			При наличии любого процента заряда каждый взмах выпускать электрические ударные волны
			При заряде выше 50% ударные волны будут вызывать цепные молнии при попадании по врагу
			Расходует энергию ([i:Redemption/EnergyCell]) на величину, равную получаемому количеству эссенций души
			'''
	}

	ReverseGeigerCounter: {
		DisplayName: Обратный счётчик гейгера
		Tooltip:
			'''
			Высвобождает слабые лучи радиации, накладывающие на врагов дебафф «{$BuffName.Poisoned}»
			'Технически - это всё ещё музыкальный инструмент, просто не в совсем привычном понимании'
			'''
	}

	SeventhSeraph: {
		DisplayName: Седьмой серафим
		Tooltip:
			'''
			Вызывает падающие с небес самонаводящиеся звёзды
			'Да начнётся апокалипсис!'
			'''
	}

	ScorchingScalpel: {
		DisplayName: Обжигающий скальпель
		Tooltip:
			'''
			Бросает 3 обжигающих скальпеля в направлении курсора
			(4[i:Redemption/EnergyCell]) Перегружает ваши скальпели
			При попадании перегруженные скальпели вызывают свои проекции, втыкающиеся во врагов
			Не требует наличия Энергоячейки в инвентаре
			'Операция раскалённым до предела скальпелем? Уже на подходе!'
			'''
	}

	Shockriken: {
		DisplayName: Шок-рикен
		Tooltip:
			'''
			(2[i:Redemption/EnergyCell]) Бросает электрошоковой сюрикен
			Может электрифицировать до 3 врагов одновременно в радиусе 40 блоков
			Наносит на 15% меньше урона за каждого электрифицированного врага
			Требуется наличие Энергоячейки в инвентаре
			'''
	}

	Synthesizer: {
		DisplayName: "{$Mods.Redemption.Items.Synthesizer.DisplayName}"
		Tooltip: "{$Mods.Redemption.Items.Synthesizer.Tooltip}"
	}

	TheTwig: {
		DisplayName: Ветвь
		Tooltip:
			'''
			Вместо вращения совершает взмахи по диагонали
			При попадании накладывает дебафф «{$BuffName.Poisoned}» и периодически оставляет во врагах крошечные лучинки
			Лучинки остаются во врагах, а нанесение им урона может заставить лучинки разлететься во все стороны
			'Это не просто ветка, эта ТА САМАЯ ветка, палочка-выручалочка прямиком из твоего ДЕТСТВА'
			'''
	}

	VirtuousFavor: {
		DisplayName: Благословение добродетели
		Tooltip:
			'''
			Выпускает искупляющий луч, который самонаводится на союзников и исцеляет их
			После исцеления луч возвращается обратно к игроку, исцеляя его на величину, равную половине восстановленного союзнику здоровья
			'Возлюби ближнего своего, как самого себя.'
			'''
	}

	VlitchSynthesizer: {
		DisplayName: Висбоящий синтезатор
		Tooltip:
			'''
			Выпускает самонаводящиеся лучи синтезатора
			(2[i:Redemption/EnergyCell]) Вызывает неточные удары молнии, призывающие ещё больше лучей синтезатора
			Не требует наличия Энергоячейки в инвентаре
			'А сейчас, вы слушаете [ИНФОРМАЦИЯ УДАЛЕНА]-FM! Здесь, мы проигрываем только самые [ИНФОРМАЦИЯ УДАЛЕНА] треки!'
			'''
	}
}

