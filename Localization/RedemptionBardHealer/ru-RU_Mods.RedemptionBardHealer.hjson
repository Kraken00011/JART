Configs: {
	BalanceConfig: {
		DisplayName: Конфигурация баланса

		elements: {
			Label: Автоматическое присваивание элементов
			Tooltip: Автоматически присваивает определённый элементальный тип урона предметам, добавляемым не Ваниллой и не Redemption.
		}

		thrower: {
			Label: Множитель урона оружия метателя
			Tooltip:
				'''
				Умножает урон метательного оружия из этого мода на указанное значение.
				(Для лучшей работы этой настройки требуется перезайти в мир!)
				'''
		}

		bard: {
			Label: Множитель урона оружия барда
			Tooltip:
				'''
				Умножает урон симфонического оружия из этого мода на указанное значение.
				(Для лучшей работы этой настройки требуется перезайти в мир!)
				'''
		}

		radiant: {
			Label: Множительно урона оружия целителя
			Tooltip:
				'''
				Умножает урон лучезарного оружия из этого мода на указанное значение.
				(Для лучшей работы этой настройки требуется перезайти в мир!)
				'''
		}

		soulEssence: {
			Label: Множитель количества эссенций души
			Tooltip:
				'''
				Умножает количество получаемых эссенций души с использованием лучезарного оружия из этого мода на указанное значение.
				Максимальное количество эссенций души, которое можно получить: 5.
				(Для лучшей работы этой настройки требуется перезайти в мир!)
				'''
		}
	}
}