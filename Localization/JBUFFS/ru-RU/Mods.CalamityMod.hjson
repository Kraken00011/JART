				'''
			Wrathwing.Tooltip:
				'''
				Бросает манёвренное самонаводящееся крылатое копьё, которое непрерывно извергает пламя, накладывающее на врагов дебафф [jbuff:CalamityMod/Dragonfire]
				При скрытном ударе попадание копьём вызывает извержение пепла
				'''
		}

		Summon: {
			AbandonedSlimeStaff.Tooltip:
				'''
