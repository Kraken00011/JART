Projectiles: {
	BloodBubble.DisplayName: Кровавый пузырь
	BloodRain.DisplayName: Кровавый дождь
	BloodReel.DisplayName: "{Items.BloodReel.DisplayName}"
	BloodShot.DisplayName: Кровавый выстрел
	BloodThorn.DisplayName: "{$ItemName.SharpTears}"
	BloodTyphoon.DisplayName: Кровавый тайфун
	DreadCatcher.DisplayName: "{Items.DreadCatcher.DisplayName}"
	Drillobite.DisplayName: "{Items.Drillobite.DisplayName}"
	DripplerCrippler.DisplayName: "{$ItemName.DripplerFlail}"
	EelectricShock.DisplayName: Электровспышка
	HemogoblinSharkToothNecklace.DisplayName: "{Items.HemogoblinSharkToothNecklace.DisplayName}"
	HemolysedBubble.DisplayName: Гемолизированный пузырь
	Hypertension.DisplayName: "{Items.Hypertension.DisplayName}"
	Nautibuss.DisplayName: "{Items.Nautibuss.DisplayName}"
	RedTide.DisplayName: "{Items.RedTide.DisplayName}"
	RedTideShock.DisplayName: "{Items.RedTide.DisplayName}"
