		}

		eyefish: {
			Label: "{$NPCName.EyeballFlyingFish}"
			Tooltip: ""
		}

		merman: {
			Label: "{$NPCName.ZombieMerman}"
			Tooltip: ""
		}

		mapIcons: {
			Label: Иконки на карте
			Tooltip: Adds map icons and boss health bars for Dreadnautilus, Hemogoblin Shark and Blood Eel.
		}

		hmStatFix: {
			Label: Исправление масштабирования характеристик в Хардмоде
			Tooltip: Disables hardmode stat scaling for Dreadnautilus, Hemogoblin Shark and Blood Eel because it causes them to have bloated stats.
		}

		expertDrops: {
			Label: Эксклюзивные предметы на сложности Эксперт
			Tooltip: ""
		}
	}
}
