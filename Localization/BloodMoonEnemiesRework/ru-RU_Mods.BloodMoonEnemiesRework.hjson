Projectiles: {
	BloodBubble.DisplayName: Кровавый пузырь
	BloodRain.DisplayName: Кровавый дождь
	BloodReel.DisplayName: "{Items.BloodReel.DisplayName}"
	BloodShot.DisplayName: Кровавый выстрел
	BloodThorn.DisplayName: "{$ItemName.SharpTears}"
	BloodTyphoon.DisplayName: Кровавый тайфун
	DreadCatcher.DisplayName: "{Items.DreadCatcher.DisplayName}"
	Drillobite.DisplayName: "{Items.Drillobite.DisplayName}"
	DripplerCrippler.DisplayName: "{$ItemName.DripplerFlail}"
	EelectricShock.DisplayName: Электровспышка
	HemogoblinSharkToothNecklace.DisplayName: "{Items.HemogoblinSharkToothNecklace.DisplayName}"
	HemolysedBubble.DisplayName: Гемолизированный пузырь
	Hypertension.DisplayName: "{Items.Hypertension.DisplayName}"
	Nautibuss.DisplayName: "{Items.Nautibuss.DisplayName}"
	RedTide.DisplayName: "{Items.RedTide.DisplayName}"
	RedTideShock.DisplayName: "{Items.RedTide.DisplayName}"
}

Items: {
	Atlateel: {
		DisplayName: Угреметалка
		Tooltip:
			'''
			Использует дротики в качестве боеприпасов
			Постепенно увеличивает наносимый урон в зависимости от времени, прошедшего с последней атаки
			Поведение предмета может сломаться при достаточно высокой скорости стрелковых атак
			'''
	}

	BloodReel: {
		DisplayName: Кровавый дугорь
		Tooltip:
			'''
			Позволяет цепляться за врагов, но делает игрока более уязвимым во время этого
			Автоматически отцепляется при достижении цели, но значительно снижает горизонтальную скорость
			'''
	}

	DreadCatcher: {
		DisplayName: Устрашающий ловец
		Tooltip: Имеет значительно больший шанс выловить врагов из водоёмов во время кровавой луны в сравнении с другими удочками
	}

	DreadnautilusEye: {
		DisplayName: Глаз Дреднаутилуса
		Tooltip: Increases health and resource regeneration for every hostile targeting the wearer
	}

	Drillobite: {
		DisplayName: Бурлобит
		Tooltip: Способен добывать блоки со значительно большей скоростью
	}

	HemogoblinSharkToothNecklace: {
		DisplayName: Ожерелье тахикардии
		Tooltip:
			'''
			Нажмите дважды в нужном направлении, чтобы совершить рывок
			Во время этого рывка вы невосприимчивы к любому типу урона, а также не подвержены гравитации
			Но во время рывка вы не можете атаковать, а во время атаки - совершать рывок
			'''
	}

	HemolysedShell: {
		DisplayName: Гемолизированный панцирь
		Tooltip:
			'''
			Высвобождает шквал кровавых пузырей
			Имеет особую синергию с кровавой колючкой
			'''
	}

	Hypertension: {
		DisplayName: Гипертония
		Tooltip:
			'''
			Удерживайте ЛКМ, чтобы зарядить шквал пронзающих кровавых сгустков
			'Сердце демона рыдает, ярко хлещет кровь струёй'
			'''
	}

	Nautibuss: {
		DisplayName: Наутилон
		Tooltip:
			'''
			Может стрелять, только если заряжено пулями
			Нажмите ПКМ, чтобы зарядить оружие до 4 раз
			Может использовать разные виды боеприпасов одновременно
			'''
	}

	RedTide: {
		DisplayName: Алая волна
		Tooltip:
			'''
			При попадании вызывает электрические вспышки, наносящие урон врагам внутри них
			Только 5 таких вспышек могут существовать одновременно
			Пока вы держите это оружие увеличивает манёвренность по водой
			Удерживайте ВВЕРХ, чтобы погружаться медленнее
			'''
	}
}

