	TerminalLucidity: {
		DisplayName: Терминальное ясновидение
		Description:
			'''
			-Механика босса-
			Пока на вас наложен этот дебафф, Пожиратель снов не может получать урон
			Мгновенно убивает вас по истечении времени действия этого дебаффа
			Дотроньтесь до разлома стабильной реальности, чтобы обнулить таймер и начать фазу нанесения урона
			Разломы стабильной реальности выглядят как ярко-фиолетовые порталы
			'Судьба приближается...'
			'''
	}

	LucidRetaliation: {
		DisplayName: Возмещающее ясновидение
		Description:
			'''
			-Механика босса-
			Пока на вас наложен этот бафф, Пожиратель снов может получать урон
			Получение урона от разломов нестабильной реальности преждевременно снимает этот бафф
			Разломы нестабильной реальности выглядят как чёрные трещины
