			Label: Photosensitivity warning
			Tooltip: Prompts a photosensitivity warning when joining a world.
		}

		bossRenames: {
			Label: Переименовывание боссов
			Tooltip: Включает/Выключает переименовывание некоторых боссов из Thorium.
		}

		starScouterEnrageText: {
			Label: "[i:ThoriumMod/StarScouterMask]Star Scouter Enrage Text"
			Tooltip:
				'''
				Whether or not Star Scouter shows a text pop-up indicating enrage.
				Only works on reworked Star Scouter, the unreworked version is unaffected by this setting as it cannot enrage.
				'''
		}

		starScouterEnrageVisuals: {
			Label: "[i:ThoriumMod/StarScouterMask]Star Scouter Enrage Visuals"
			Tooltip:
				'''
				Whether or not Star Scouter turns red when enraged.
				Only works on reworked Star Scouter, the unreworked version is unaffected by this setting as it cannot enrage.
				'''
		}

		lichOutline: {
			Label: "[i:ThoriumMod/LichMask]Lich Aura Intensity"
			Tooltip:
				'''
				Controls the intensity of the faint red glow around the Lich.
				Only works on reworked Lich, the unreworked version is unaffected by this setting.
				Use this if you want visual parity with the original design or if you're having troubles seeing him.
				'''
		}
	}

	CompatConfig: {
		DisplayName: Настройки кросс-совместимости

		healthScale: {
			Label: Множитель здоровья
			Tooltip: Multiplies the health of Thorium's bosses by this amount.
		}

		damageScale: {
			Label: Множитель урона
			Tooltip: Multiplies the attack damage of Thorium's bosses by this amount.
		}

		speedScale: {
			Label: Множитель скорости
			Tooltip:
				'''
				Multiplies the movement speed of Thorium's bosses by this amount.
				Limited to 2x speed as any higher breaks bosses.
				'''
		}

		sheathFix: {
			Label: Исправления и улучшения ножен мечей
			Tooltip: Fixes some sheath-related inconsistencies and allows them to work on more swords.
		}

		terraItemsFix: {
			Label: Паритовность рецептов терра-предметов Thorium
			Tooltip:
				'''
				(Рекомендовано!)
				Changes all of the Terra weapons from Thorium to use similar recipes to the vanilla Terra Blade.
				Automatically disabled if Unofficial Calamity Bard & Healer is installed as that mod already does this.
				'''
		}

		extraItems: {
			Label: Новые предметы
			Tooltip:
				'''
				(Необязательно)
				Adds some unrelated items that are from this mod.
				'''
		}

		extraPotions: {
			Label: Новые зелья
			Tooltip:
				'''
				(Необязательно)
				Adds some buff potions relating to Thorium's class that are from this mod.
				'''
		}

		extraPrefixes: {
			Label: Новые префиксы
			Tooltip:
				'''
				(Необязательно)
				Adds some prefixes relating to Thorium's class items that are from this mod.
				'''
		}

		masterDrops: {
			Label: Master Mode Drops
			Tooltip:
				'''
				(Рекомендовано!)
				Thorium's bosses will have exclusive weapons dropped in master, revengeance or eternity mode.
				'''
		}

		masterDropRate: {
			Label: Частота выпадения предметов сложности Мастер в процентах
			Tooltip: NOTE: This is overriden in eternity mode if "eternity mode only" setting is enabled to match the drop rates of other eternity boss drops
		}

		masterDropsAreNonExclusive: {
			Label: Master weapon drops are expert drops
			Tooltip:
				'''
				Master mode exclusive weapons drop in expert mode.
				Recommended if you don't like playing on master or other mods break master drops.
				(e.g. eternity mode becoming masochist mode or infernum not being usable in master mode)
				'''
		}

		itemReworks: {
			Label: Переработка некоторых предметов Thorium
			Tooltip:
				'''
				(Рекомендовано!)
				Reworks some items from Thorium mod to be a lot better.
				'''
		}

		postDoGRag: {
			Label: Перемещение Первородных в прогрессии с Calamity или Fargo's
			Tooltip:
				'''
				(Рекомендовано!)
				Перемещает битву с Первородными на этап пост-Пожиратель богов в игровой прогрессии.
				Перемещает на пре-Эридан с Fargo's Souls.
				Если включены оба мода, перемещает битву на этап между ними.
				'''
		}

		vanillaBard: {
			Label: Конвертация звёздного мотива и магической арфы в класс барда
			Tooltip: Конвертирует класс звёздного мотива и магической арфы в барда, делая их струнными инструментами, способными накладывать усиления.
		}

		DoD: {
			Label: Пожиратель грёз (Шуточная настройка)
			Tooltip:
				'''
				This setting is entirely a joke, it gives Devourer of Gods Dream Eater's original attacks.
				May or may not be fair and balanced.
				'''
		}

		thorlamityBR: {
			Label: Боссы Thorium в Босс-раше Calamity
			Tooltip: Thorium Bosses spawn in Calamity Boss Rush, ordered according to appropriate tier of progression.
		}

		auricBar: {
			Label: Создание ауритового слитка требует материалы из Thorium
			Tooltip: При включении ауритовые слитки из Calamity будут требовать для создания 3 эссенции Первородных.
		}

		defenseDamage: {
			Label: Поддержка урона по защите
			Tooltip:
				'''
				Позволяет некоторым атакам боссов из Spirit наносить урон по защите.
				Работает только, если включён Calamity Mod.
				'''
		}

		eternityModeOnly: {
			Label: Только в режиме Вечность
			Tooltip:
				'''
				При включении переработки боссов этого мода будут работать только, если включён режим Вечность или Мазохист.
				Also changes master weapon drops (if enabled) into eternity weapon drops.
				Additionally, Thorium bosses can now drop eternity mode accessories.
				This setting does nothing if Fargo's Souls is not installed.
				'''
		}

		infernumModeOnly: {
			Label: Только в режиме Инфернум
			Tooltip:
				'''
				При включении переработки боссов этого мода будут работать только, если включён режим Инфернум.
				Ничего не делает, если не включён Infernum Mode.
				'''
		}
	}

