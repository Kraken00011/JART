Achievements: {
	CoreCollapse: {
		FriendlyName: Подрыв ядра
		Description: Уничтожить все ядра Звёздного разведчика, потратив на это не более 6 секунд. Defeat all three of Star Scouter's cores in under six seconds
	}

	MyBatsAreKindaChamberless: {
		FriendlyName: Бескровные кровосиси
		Description: Одержать победу над Виконтом, не позволив ни одной его летучей мыши высосать из вас кровь. Defeat Viscount without letting a single Bitey Baby siphon life from you
	}
}

