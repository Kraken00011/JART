		Tooltip: Даёт эффекты от предмета «{$ItemName.HandWarmer}»
	}

	TerrariumSoulScourge: {
		DisplayName: Террариевый бич душ
		Tooltip:
			'''
			Swings a prismatic mace that releases lingering healing energy on its first hit
			Up to 10 healing energy can exist at once
			Summons rainbow copies of itself on healing orb generation
			'''
	}

	TitanHat: {
		DisplayName: Титаническая шляпа
		Tooltip:
			'''
			'Наполнен первородной энергией'
			Увеличивает скорость симфонической игры и скорость восстановления вдохновения на 15%
			Увеличивает длительность усилений на 3 секунды
			Значительно увеличивает радиус действия усилений
			'''
	}

	TitanHood: {
		DisplayName: Титанический капюшон
		Tooltip:
			'''
			'Наполнен первородной энергией'
			Увеличивает скорость метательных атак на 15%
			Увеличивает максимальное число очков техники на 3
			Не расходуемое метательное оружие будет изматывать вас на 40% слабее
			'''
	}

	TitanVisage: {
		DisplayName: Титанический лик
		Tooltip:
			'''
			'Наполнен первородной энергией'
			Увеличивает лучезарный урон и скорость произнесения заклинаний на 15%
			Исцеляющие заклинания восстанавливают дополнительно 6 ед. здоровья
			Позволяет исцеляющим заклинаниям наносить критические удары, удваивающие их исцеление
			'''
	}

	TitanVisor: {
		DisplayName: Титаническая личина
		Tooltip:
			'''
			'Наполнен первородной энергией'
			Увеличивает максимальное количество миньонов на 3 и стражей на 1
			Увеличивает дальность хлыстов 15%
			Увеличивает шанс критического удара призывателя на 6%
			Позволяет миньонам и стражами периодически наносить критические удары
			'''
	}

	ThoriumBludgeon: {
		DisplayName: Ториевая колотушка
		Tooltip:
			'''
			Взмахивает радиоактивной булавой, выпускающей парящие на месте заряды исцеляющей энергии при условии, что первый удар по врагу был нанесён именно этим оружием
			Одновременно может существовать только 2 таких заряда
			'''
	}

	ThoriumHeavyScythe: {
		DisplayName: Тяжёлая ториевая коса
		Tooltip: Вместо вращения совершает взмахи по диагонали
	}

	ThoriumWhistle: {
		DisplayName: Ториевый свисток
		Tooltip: Стреляет очередью из нескольких молний
	}

	UndyingGaze: {
		DisplayName: "{$Mods.ThoriumRework.Items.UndyingGazeCosmetic.DisplayName}"
		Tooltip:
			'''
			Нанесение критического удара будет гарантировано давать эссенции души Any critical strike now grants Soul Essence
			Атаки, расходующие здоровье для атаки, также будут эссенции при любом попадании Attacks that use life will grant Soul Essence on any hit
			Атаки, уже дающие эссенции души, будут давать их увеличенное количество Attacks that already grant Soul Essence will grant an extra charge
			'''
	}

	UndyingGazeCosmetic: {
		DisplayName: Бессмертная благодать
		Tooltip: Ваши глаза будут слегка подсвечены
	}

	ValadiumHeavyScythe: {
		DisplayName: Тяжёлая валадиумовая коса
		Tooltip:
			'''
			Вместо вращения совершает взмахи по диагонали
			Выпускает шлейф тёмной энергии короткой дальности, пронзающий врагов
			Нанесение урона разрывает врагов межпространственной энергией
			'''
	}

	ValkyrienSkyStone: {
		DisplayName: Валькирский камень небес
		Tooltip:
			'''
			[i:ThoriumRework/StarScoutReticle] Allows breathing in space and grants night vision
			[i:ThoriumRework/StarScoutReticle] Dashing teleports you a few blocks forward and gives you a dash if you don't have one yet
			[i:ThoriumRework/BannerofWar] Damage and bonus healing increases over time while in combat but gradually fade when out of combat
			[i:ThoriumRework/BannerofWar] While in combat, periodically emit a healing pulse that heals allies equal to bonus healing, bard empowerment range affects the range of the pulse
			[i:ThoriumRework/BannerofWar] The frequency of the pulses increases the longer you are in combat
			[i:ThoriumRework/BandofCratons] Grants a passive 40 shield, immunity to Overflowed and makes your attacks inflict it
			[i:ThoriumRework/BandofCratons] Restores player resources based on the amount of shield lost, losing more than 20 shield creates an electric shock that destroys 3 projectiles
			'''
	}

	VampireCape: {
		DisplayName: "{$Mods.ThoriumRework.Items.VampireCapeCosmetic.DisplayName}"
		Tooltip: Даёт невосприимчивость к дебаффам «{$BuffName.Bleeding}» и «{$Mods.ThoriumMod.Buffs.VampiresCurseBuff.DisplayName}»
	}

	VampireCapeCosmetic: {
		DisplayName: Плащ летучей мыши-вампира
		Tooltip: ""
	}

	ZephyrsRuin: {
		DisplayName: Зефирова погибель
		Tooltip:
			'''
			Вонзается во врагов или, если промахнётся, в поверхность
			Через некоторое время в точку поражённого атакой врага ударяет наносящая урон молния
			При нанесении критического удара молния мгновенно бьёт в поражённого врага
			Вы не изматываетесь от использования этого предмета
			'А говорили молния в одно месте дважды не бьёт'
			'''
	}

	ZephyrWings: {
		DisplayName: "{$Mods.ThoriumRework.Items.ZephyrWingsCosmetic.DisplayName}"
		Tooltip:
			'''
			{$Mods.ThoriumRework.Items.ZephyrWingsCosmetic.Tooltip}
			Зацепление за воздух с помощью хватки Зефира увеличивает время полёта
			Zephyr's Grip's hatchling can be summoned again after gliding for a while
			Dealing damage allows the hatchling to be resummonable much sooner
			'''
	}

	ZephyrWingsCosmetic: {
		DisplayName: Зефировы крылья
		Tooltip:
			'''
			Позволяет летать и плавно парить
			Имеет те же характеристики, что и крылья птенца
			'''
	}
}

