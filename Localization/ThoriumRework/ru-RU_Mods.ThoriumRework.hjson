Items: {
	BandofCratons: {
		DisplayName: "{$Items.BandofCratonsCosmetic.DisplayName}"
		Tooltip:
			'''
			Даёт невосприимчивость к дебаффу «{$Mods.ThoriumMod.Buffs.GraniteSurge.DisplayName}», а ваши атаки будут накладывать его
			Даёт 40 ед. жизненного щита
			Восстанавливает ресурсы игрока в зависимости от количества потерянного щита Restores player resources based on the amount of shield lost
			При потере более 20 ед. щита выпускает электрошок, уничтожающий 3 ближайших снаряда
			{$Items.BandofCratonsCosmetic.Tooltip}
			'''
	}

	BandofCratonsCosmetic: {
		DisplayName: Повязка кратонов
		Tooltip: "'Достаточно прочна, чтобы выдержать сдвиг континентальных плит'"
	}

	BannerofWar: {
		DisplayName: "{$Items.BannerofWarCosmetic.DisplayName}"
		Tooltip:
			'''
