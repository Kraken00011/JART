	SoulofDightinaBottle.MapEntry: Эссенция оберегания в банке
	SoulofFreightinaBottle.MapEntry: Эссенция страха в банке
	SoulofPlightinaBottle.MapEntry: Эссенция боли в банке
	SoulofTightinaBottle.MapEntry: Эссенция сплочения в банке
}

Buffs: {
	AdamantiteSpades: {
		DisplayName: Адамантитовые пики
		Description: Множество адамантитовых пик вращаются вокруг вас
	}

	ExcaliburRage: {
		DisplayName: Гнев Артура
		Description: Скорость атаки ближнего боя увеличена на 33%
	}

	ElectromagneticFlux: {
		DisplayName: Электромагнитный мех
		Description:
			'''
			Урон и скорость атаки увеличены на 10%
			Бесконечный полёт
			'Вы чувствуете себя усиленным!'
			'''
	}

	Flinxcopter: {
		DisplayName: Воздушные силы флинксов
		Description: "'Сбрасываем бомбу, капитан!'"
	}

	MarkedforNegationNegative: {
		DisplayName: Посмертно отмеченный (Отрицательный заряд)
		Description:
			'''
			Скорее, дотроньтесь до пурпурных клонов, пока не стало слишком поздно!
			(Вы получите урон, если выберите неправильный цвет)
			'''
	}

	MarkedforNegationNeutral: {
		DisplayName: Посмертно отмеченный (Нейтральный заряд)
		Description:
			'''
			Скорее, дотроньтесь до жёлтых клонов, пока не стало слишком поздно!
			(Вы получите урон, если выберите неправильный цвет)
			'''
	}

	MarkedforNegationPositive: {
		DisplayName: Посмертно отмеченный (Положительный заряд)
		Description:
			'''
			Скорее, дотроньтесь до голубых клонов, пока не стало слишком поздно!
			(Вы получите урон, если выберите неправильный цвет)
			'''
	}

	MechanicalJet: {
		DisplayName: Механический истребитель
		Description: Богоподобная скорость!
	}

	MissileBattery: {
		DisplayName: Ракетный ранец
		Description: Сливает IP адреса ваших противников
	}

	Nanny: {
		DisplayName: B-33 «Нянька»
		Description: "'Она сможет помочь вам наконец-то выспаться'"
	}

	RockCancer: {
		DisplayName: Каменный рак
		Description: Ваша кровь кристаллизуется...
	}

	Safesys: {
		DisplayName: М0р-0з
		Description: Кажется, он куда больше изнутри!
	}

	Termini: {
		DisplayName: Термини
		Description: Слушай... да эта милаха и мухи не обидит!
	}
}

Items: {
	AbominationRemote: {
		DisplayName: Подозрительно выглядящая коробка
		Tooltip:
			'''
			На ней располагается записка с очень странной поэмой, в поэме есть несколько выделенных слов:
			'Ты – не [c/00FFFF:ровня] тому, что скрывается внутри неё.'
			'Ты встретишься лицом к лицу с [c/FFFF00:тем], что называется «последствия своих действий»!'
			'О, пусть тёмные [c/FF00FF:цвета] ночного неба преследуют тебя даже во сне...'
			'О, пусть оно [c/FF0000:уничтожит] все твои желания!'
			'Да пусть твари из тьмы наконец поймают тебя уже за [c/00FF00:хвост].'
			'И наконец, пусть каждые [c/0000FF:сегменты] твоего тела будут стёрты и превращены в безжизненные угли.'
			Возможно, эти слова – подсказка к тому, с чем вам предстоит сразиться...
			'''
	}

	AdvancedCombinationLock: {
		DisplayName: Улучшенный кодовый замок
		Tooltip:
			'''
			Призывает крохотного меха-оленя, хранящего за вас предметы, а также способного охлаждать ваши напитки!
			Сейф меха-оленя имеет бесконечный радиус действия, ведь он всегда поспевает за вами
			'Его кодовый замок такой мелкий и довольно-таки сложно дешифруемый, но к счастью у него есть функция распознавания лица!'
			'''
	}

	Anemoscepter: {
		DisplayName: Анемопосох
		Tooltip: 
			'''
			Удерживайте ЛКМ, чтобы зарядить атаку
			При полной зарядке отпустите, чтобы выпустить небольшой, но мощный вихрь
			'''
	}

	ArtificialStinger: {
		DisplayName: Искусственный Стингер
		Tooltip:
			'''
			Использует дротики и стрелы в качестве боеприпасов
			Сверхзаряжает загруженные боеприпасы, делая их сильнее
			Сверхзаряженные стрелы вызывают ионную вспышку при попадании
			Нажмите ПКМ, чтобы зарядить магнитные дротики, втыкающиеся во врагов
			Заряженные стрелы самонаводятся на врагов с воткнутыми магнитными дротиками
			'Создан для стимуляции боли тысячи жал'
			'''
	}

	Avalanche: {
		DisplayName: Лавина
		Tooltip:
			'''
			Использует снежки в качестве боеприпасов
			Заряжайте оружие, чтобы увеличить максимальное количество выпускаемых снежков
			При полной зарядке снежки наполняются шрапнелью
			'Нет, оно не готовит мороженное'
			'''
	}

	BeeController: {
		DisplayName: Пчелиный пульт управления
		Tooltip:
			'''
			Призывает помощника В-33, следующего за вашим курсором
			Охлаждает владельца когда тот засыпает на кровати
			'Утром рано встаёт охрана...'
			'''
	}

	BeeRemote: {
		DisplayName: Подозрительно выглядящий меха-пчела
		Tooltip:
			'''
			Призывает «Хранителя»
			'Вы слышите странное жужжание...'
			'''
	}

	Beforeshock: {
		DisplayName: Лёгкие толчки
		Tooltip:
			'''
			Стреляет 3 очередями, по 5 пуль в каждой
			Первая очередь дополнительно вызывает массивную ударную волну в направлении атаки
			'Лёгкие толчки – постоянно повторяющиеся толчки, предвещающие начало самого землетрясения'
			'''
	}

	Bloodshed: {
		DisplayName: Кровоток
		Tooltip: ""
	}

	BloodStainedPocketWatch: {
		DisplayName: Окровавленные карманные часы
		Tooltip: Призывает окровавленные серебряные клинки, летящие в направлении курсора
	}

	BrainRemote: {
		DisplayName: Подозрительного выглядящий меха-мозг
		Tooltip:
			'''
			Призывает Терминатора
			'{$LegacyMisc.29}'
			'''
	}

	BreachCutter: {
		DisplayName: Плазменный резак
		Tooltip:
			'''
			Стреляет двумя соединёнными сферами плазмы
			Игнорирует часть вражеской брони
			'''
	}

	CaretakerBossBag: {
		DisplayName: Мешок с сокровищами (MK-22 «Хранитель»)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	CaretakerMask: {
		DisplayName: Маска «Хранителя»
		Tooltip: ""
	}

	CaretakerRelic: {
		DisplayName: Реликвия «Хранителя»
		Tooltip: ""
	}

	CaretakerTrophy: {
		DisplayName: Трофей «Хранителя»
		Tooltip: ""
	}

	ClockworkWrench: {
		DisplayName: Заводной гаечный ключ
		Tooltip: Призывает заводную турель, стреляющую высокоскоростными пулями в ближайших врагов
	}

	DeerRemote: {
		DisplayName: Подозрительно выглядящий меха-олень
		Tooltip:
			'''
			Призывает Ст4-зис
			'Вы слышите отдалённый грохот стали...'
			'''
	}

	DoubleTrouble: {
		DisplayName: Двойная угроза
		Tooltip:
			'''
			Взмахивает либо Спазматизмом, либо Ретинайзером
			Ретинайзер стреляет лазерами, а Спазматизм проклятым пламенем
			Каждый 3 удар взмахивает и Спазматизмом и Ретинайзером одновременно
			Считается хлыстом, но бонусы к дальности хлыстов этот предмет не получает
			'''
	}

	EnergyHilt: {
		DisplayName: Энергетическая рукоять
		Tooltip:
			'''
			Атаки ближнего боя пробивают 10 ед. брони
			Лазерные сабли стреляют световой волной на небольшое расстояние
			'''
	}

	Exitium: {
		DisplayName: Ликвидация
		Tooltip:
			'''
			Взмахи копьём периодически выпускают молнии и ракеты
			Ракеты самонаводятся на ближайшего к вашему курсору врага
			Нажмите ПКМ, чтобы взорвать все выпущенные ракеты
			Копье может атаковать сквозь блоки
			'Разыскать и ликвидировать'
			'''
	}

	EyeRemote: {
		DisplayName: Подозрительно выглядящий меха-глаз
		Tooltip:
			'''
			Призывает Близнецов
			'Это будет кошмарная ночь...'
			'''
	}

	Finis: {
		DisplayName: Вопль смерти
		Tooltip:
			'''
			Каждый 3 взмах бросает косу в направлении курсора
			Бросок косы призывает заряды, вращающиеся вокруг игрока
			Удерживайте ПКМ во время атаки, чтобы автоматически навести косу на ближайшего врага
			При попадании по врагу косой во время её броска высвобождает вращающиеся вокруг вас заряды и нацеливает их на поражённого врага
			'''
	}

	FlinxForceWalkieTalkie: {
		DisplayName: Рация флинксов
		Tooltip: Призывает флинкскоптеры, сбрасывающие бомбы на ваших врагов
	}

	HandPrime: {
		DisplayName: Рука Прайм
		Tooltip:
			'''
			Нажмите ПКМ, чтобы переключаться между 4 разными модулями
			Модуль лазера: стреляет очередью красных лазеров
			Модуль ракетницы: стреляет самонаводящимися красными ракетами
			Модуль пилы: превращается в пилу и кромсает врагов на кусочки
			Переключение модуля или смена предмета выпустят пилу в направление курсора
			Модуль пилы не сможет атаковать пока снаряд пилы не пропадёт
			Модуль крюка: стреляет крюком, вонзающийся за врагов
			Нажмите ЛКМ, чтобы притянуть себя к вонзённому крюку
			'''
	}

	HarmonicWeaponCatalyst: {
		DisplayName: Гармонизированный оружейный катализатор
		Tooltip:
			'''
			Увеличивает урон, скорость атаки и шанс критического удара на 10%, а также пробивание брони на 10 ед.
			При использовании некоторых типов оружия вы будете получать дополнительные бонусы, связанные с их классом:
			[c/e51919:Воин]: Во время атаки увеличивает сопротивление урону на 10%, но враги будут чаще выбирать вас в качестве цели
			[c/00aa38:Стрелок]: Даёт 10% шанс не потратить боеприпасы и увеличивает дальность снарядов
			[c/0e81f4:Маг]: Увеличивает максимальный запас маны на 60 ед., снижает расход маны на 10%, а также при низком здоровье даёт постоянное восстановление маны
			[c/f87abe:Призыватель]: Увеличивает максимальное количество стражей и миньонов на 2, а также враги будут реже выбирать вас в качестве цели
			[c/ffa53c:Метатель]: Увеличивает дальность метательных снарядов на 10%
			[c/ffa53c:Разбойник] (Calamity): Увеличивает максимальный запас скрытности и скорость разбойных снарядов на 10%
			[c/00ff80:Бард] (Thorium): Увеличивает максимальный запас вдохновения на 4 очка, длительность усилений на 5 секунд и радиус действия усилений на 15 блоков
			[c/ffff5b:Целитель] (Thorium): Снижает расход маны на 10%, исцеляющие заклинания восстанавливают дополнительно 2 ед. здоровья
			[c/7746d7:Пустота] (Secret of the Shadows): Снижает урон от дебаффов «Пустотный шок» и «Пустотное восстановление»
			'''
	}

	Jumboshark: {
		DisplayName: Джамбо-акула
		Tooltip:
			'''
			Стреляет 3 пулями одновременно
			'Дальний родственник мини-акулы'
			'''
	}

	Killswitch: {
		DisplayName: Аварийный механизм
		Tooltip:
			'''
			Призывает Термини, который будет следовать за вами
			'Да ты посмотри на него! Какой же он милашка!'
			'''
	}

	KineticTremors: {
		DisplayName: Кинетический сотрясатель
		Tooltip:
			'''
			Удерживайте ЛКМ, чтобы зарядить огромный молот, вызывающий ударные волны при столкновении
			Молот может вызывать множество ударных волн подряд, позволяя наносить урон несколько раз за одну атаку
			'При создании было использовано небольшое количество... боеголовок'
			'''
	}

	HydraulicPressManual: {
		DisplayName: Руководство по гидравлике
		Tooltip:
			'''
			Нажмите ЛКМ по врагу, чтобы сдавить его гидравлическим прессом
			'Своеобразный АСМР'
			'''
	}

	LaserStar: {
		DisplayName: Лазерная звезда
		Tooltip: При попадании по врагу создаёт лазерные лучи
	}

	MechanicalCockpitPiece: {
		DisplayName: Механическая деталь кабины
		Tooltip: ""
	}

	MechanicalJet: {
		DisplayName: Механический истребитель
		Tooltip:
			'''
			Призывает быстрый, парящий в воздухе истребитель
			После разгона до максимальной скорости начинает наносить контактный урон
			Любые атаки выпускают множество ракет, урон которых зависит от вашей скорости атаки
			'По крайней мере, в этом мире легко достать топливо для истребителей'
			'''
	}

	MechanicalWings: {
		DisplayName: Механический ранец
		Tooltip:
			'''
			Позволяет летать и плавно парить
			Нажмите ВНИЗ, чтобы парить
			Нажмите ВВЕРХ, чтобы перестать парить
			Удерживайте ВВЕРХ, чтобы ускориться
			Удерживайте ВНИЗ пока вы вне полёта, чтобы ускорить падение
			'Создаётся проще, а работает даже лучше!'
			'''
	}

	MechclopsBossBag: {
		DisplayName: Мешок с сокровищами (Ст4-зис)
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	MechclopsMask: {
		DisplayName: Маска Ст4-зис
		Tooltip: ""
	}

	MechclopsRelic: {
		DisplayName: Реликвия Ст4-зис
		Tooltip: ""
	}

	MechclopsTrophy: {
		DisplayName: Трофей Ст4-зис
		Tooltip: ""
	}

	OverloadScope: {
		DisplayName: Перегруженный прицел
		Tooltip:
			'''
			Нажмите ПКМ, чтобы отдалить с любым оружием в руках
			Удерживайте ПКМ, чтобы начать медленно прицеливаться
			После успешного прицеливания отмечает ближайшего к курсору врага
			При попадании по отмеченному врагу вызывает мощный взрыв
			Враг, подверженный любому дебаффу, может взорваться самостоятельно
			'''
	}

	RepurposedBeeRemote: {
		DisplayName: Коды запуска боеголовок
		Tooltip:
			'''
			Призывает ракетный ранец на вашу спину
			Ранец будет выстреливать большим количеством ракет за каждый занятый им слот миньонов
			'Межконтинентальный комплекс баллистических ракет, только он сможет противостоять этому'
			'''
	}

	RepurposedBrainRemote: {
		DisplayName: Терминальный град
		Tooltip:
			'''
			Стреляет очередью из 3 лазеров
			Наносит контактный урон
			При попадании по врагу может с определённым шансом призвать небольшого дрона
			Не тратит боеприпасы
			'Нет времени объяснять'
			'''
	}

	RepurposedDeerRemote: {
		DisplayName: Крикливый горн
		Tooltip:
			'''
			Выпускает усиленный, пронзающий крик 
			'Отправляет пожелания смерти за зону слышимости B)'
			'''
	}

	RepurposedDeerRemoteBard: {
		DisplayName: "{$Mods.PrimeRework.Items.RepurposedDeerRemote.DisplayName}"
		Tooltip: "{$Mods.PrimeRework.Items.RepurposedDeerRemote.Tooltip}"
	}

	RepurposedEyeRemote: {
		DisplayName: Закольцованное глазное яблоко
		Tooltip: Призывает мелких Ретинайзеров, стреляющих лазерами
	}

	RepurposedSkullRemote: {
		DisplayName: Стальной череп
		Tooltip: Призывает руки Прайма сражаться за вас
	}

	RepurposedWormRemote: {
		DisplayName: Стальной червь
		Tooltip:
			'''
			25% шанс при попадании призвать дружественного зонда
			'Уничтожитель, но в виде хлыста'
			'''
	}

	PlasmaPistol: {
		DisplayName: Плазменный пистолет
		Tooltip:
			'''
			Стреляет концентрированной плазмой
			Удерживайте ЛКМ, чтобы зарядить выстрел и увеличить концентрированность плазмы
			Полностью заряженный выстрел плазмы выпускает куда больше снарядов в сравнении с незаряженным
			'''
	}

	PortableEnergyConverter: {
		DisplayName: Карманный преобразователь энергии
		Tooltip:
			'''
			Увеличивает скорость магических атак на 10%
			Некоторые магические пушки перестанут расходовать ману
			'''
	}

	SelfCoolingPitcher: {
		DisplayName: Самоохлаждающийся кувшин
		Tooltip:
			'''
			Нажмите ПКМ по этому кувшину в инвентаре, пока держите любое зелье, чтобы влить его внутрь
			Длительность вылитых в кувшин баффов от зелий увеличивается вдвое
			При повторном вливании уже находящихся внутри зелий их длительность увеличивается,
			но это дополнительное время действия для баффов не удваивается
			Кувшин может хранить в себе до 20 баффов, дубликаты зелий также занимают отдельное место как и любой другой бафф
			'Наслаждайтесь своими охлаждёнными зельями регенерации!'
			<empty>
			'''
		Full: Накладывает следующие баффы:
		Empty: Пусто
	}

	SiegeDowner: {
		DisplayName: Осадные щиты
		Tooltip:
			'''
			Призывает 4 шипастых щита, отражающих большинство вражеских снарядов
			Щиты откидываются после получении урона, с течением времени начиная расшатываться
			Расшатанные щиты неуправляемо вращаются и во время этого перестают отражать снаряды
			'Я - НЕУЯЗВИМЫЙ!'
			'''
	}

