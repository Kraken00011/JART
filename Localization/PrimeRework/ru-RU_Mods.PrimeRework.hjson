Configs: {
	ReworkConfig: {
		DisplayName: Конфигурация переработок

		twins: {
			Label: "[i/s1:544] Переработка Близнецов"
			Tooltip:
				'''
				Включает переработку Близнецов. 
				Если эта переработка конфликтует с другими модами, вы можете её легко отключить.
				Настройка работает с режимами Вечность и Месть, так что отключать её не нужно, даже если что-то из этого включено.
				(ПРИМЕЧАНИЕ: Паттерны атак комбинируются, не заменяются!)
				'''
		}

		destroyer: {
			Label: "[i/s1:556] Переработка Уничтожителя"
			Tooltip:
				'''
				Включает переработку Уничтожителя. 
				Если эта переработка конфликтует с другими модами, вы можете её легко отключить.
				Настройка работает с режимами Вечность и Месть, так что отключать её не нужно, даже если что-то из этого включено.
				(ПРИМЕЧАНИЕ: Паттерны атак комбинируются, не заменяются!)
				'''
		}

		prime: {
			Label: "[i/s1:557] Переработка Скелетрона Прайма"
			Tooltip:
				'''
				Включает переработку Скелетрона Прайма.
				Если эта переработка конфликтует с другими модами, вы можете её легко отключить.
				Настройка работает с режимами Вечность и Месть, так что отключать её не нужно, даже если что-то из этого включено.
				(ПРИМЕЧАНИЕ: Паттерны атак комбинируются, не заменяются!)
				'''
		}

		oldAI: {
			Label: Старые переработки ИИ
			Tooltip:
				'''
				Включает старые версии переработок боссов.
				Примечание: старый ИИ есть только у Уничтожителя.
				'''
		}

		Death: {
			Label: Анимации смерти
			Tooltip: Включает анимации смерти механических боссов.
		}

		masterDropsAreNonExclusive: {
			Label: Выпадение оружия Мастера на сложности Эксперт
			Tooltip:
				'''
				Эксклюзивное для сложности Мастер оружие теперь сможет выпадать и на сложности Эксперт.
				Рекомендуется, если вам не нравится играть на Мастере или сторонние моды его ломают.
				(Например: режим Вечность на Мастере становится Мазохистом, а Инфернум не позволяет играть на Мастере вообще)
				'''
		}

