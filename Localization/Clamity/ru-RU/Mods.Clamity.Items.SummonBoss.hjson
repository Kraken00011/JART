ClamitasSummoningItem: {
	DisplayName: Панцирь Каламидии
	Tooltip:
		'''
		Призывает Каламидию при использовании в серном утёсе
		Не расходуется
		'''
}

EyeofStupidity: {
	DisplayName: Глаз тупизма
	Tooltip:
		'''
		Призывает легендарнейшую среди всех высших Каламидий в невероятно крутом шмоте Ксерока от Supreme
		Ну привет, AdamChromeE
		'''
}

PyroKey: {
	DisplayName: Пироключ
	Tooltip:
		'''
		Призывает Пирогена при использовании в пустыне
		Нажмите ПКМ, чтобы пропустить анимацию призыва
		Нахождение вне пустыни приводит босса в ярость
		Не расходуется
		'Ключ от адского куба'
		'''
}

AncientConsole: {
	DisplayName: Древняя консоль
	Tooltip:
		'''
		Нажмите ПКМ по любому блоку, чтобы призвать Стену бронзы
		Можно использовать только в преисподней
		Стена бронзы исчезает, когда вы выходите из преисподней
		ПРЕДУПРЕЖДЕНИЕ: Если вы играете в мультиплеере, то настоятельно рекомендуется
		сделать особый предмет для призыва (он делается из этого же предмета)
		'''
}

WoBSummonItem: {
	DisplayName: Технически альтернативный бронзовый механизм
	Tooltip:
		'''
		Призывает Стену бронзы при использовании в преисподней
		Не расходуется
		'''
}