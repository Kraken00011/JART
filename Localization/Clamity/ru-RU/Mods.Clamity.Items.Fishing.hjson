WulfrumLure: {
	DisplayName: Вульфрумовый заманиватель
	Tooltip:
		'''
		Запускает 3 поплавка одновременно
		Нажмите ПКМ, чтобы зарядить удочку [i:CalamityMod/EnergyCore] энергетическим ядром
		Заряженная удочка бросает 7 поплавков за раз, а её навык рыболовной ловли усиливается на 70%
		Заряженную удочку можно использовать до 10 раз, после чего она разряжается
		[c/83B87E:'На удивление прочная конструкция, для такого-то куска металлолома!]
		[c/83B87E:...а вот его основание уже не может похватат.']
		'''
}

FishOfFlame: {
	DisplayName: Рыба пламени
