ClamitasCrusher: {
	DisplayName: Дробитель Каламидий
	Tooltip:
		'''
		Швыряет среднего размера Каламидию, ненадолго оглушающую врагов при попадании
		Создает самонаводящиеся серные огни в полёте или при попадании по врагу
		При нахождении в воздухе определённое количество времени Каламидия начинает подвергаться воздействию гравитации и наносить увеличенный урон
		'''
}

SearedShredder: {
	DisplayName: Обожжённый измельчитель
	Tooltip: Releases a flaming scythe that follows your mouse and returns after a short time
}

RGBMurasama: {
	DisplayName: Мурасама с RGB-подсветкой
	Tooltip:
		'''
		Высокочастотный клинок, способный легко разрезать даже самых могущественных врагов
		Каждый третий взмах наносит огромный урон
		Докажите свою силу, сразив Пожирателя богов, чтобы вытащить этот клинок из ножен
		'И прольётся кровь да радуга!'
		'''
}

Disease: {
	DisplayName: Болезнь
	Tooltip: При попадании выпускает чумных искателей
}

WulfrumLeechDagger: {
	DisplayName: Вульфрумовый кинжал-пиявка
	Tooltip:
		'''
		Не может наносить критические удары
		При попадании по врагу отнимает немного его здоровья
		'''
}

