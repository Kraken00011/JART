Clamitas: {
			ClamitasShelleggings: {
				DisplayName: Панцирные поножи Каламидии
				Tooltip: Увеличивает урон на 13% и шанс критического удара на 5%
			}

			ClamitasShellmet: {
				DisplayName: Панцирный шлем Каламидии
				Tooltip:
					'''
					Увеличивает урон на 6% и шанс критического удара на 5%
					Периодически создает осколки призмы, кратковременно оглушающие врагов
					'''
				SetBonus:
					'''
					Призывает трёх моллюсков, которые помогают вам в бою
					Увеличивает максимальное количество миньонов на 4
					'''
			}

			ClamitasShellplate: {
				DisplayName: Панцирные латы Каламидии
				Tooltip:
					'''
					Увеличивает урон на 12% и шанс критического удара на 7%
					Замедляет ближайших врагов; этот эффект не работает во время битвы с боссом
					Обеспечивает небольшим количеством света в бездне
					'''
			}
		}

		Vanity: {
			PyrogenMask: {
				DisplayName: Маска Пирогена
				Tooltip: ""
			}

			WoBMask: {
				DisplayName: Маска Стены бронзы
				Tooltip: ""
			}

			AradirMask: {
				DisplayName: Маска Арадира
				Tooltip:
					'''
					Добро пожаловать в математический ад:
					float b = MathF.Sin((Main.GlobalTimeWrappedHourly * (1 + lerp * 3) - j / 2f)
					* (1 + new UnifiedRandom(i).NextFloat(0, 1))) * 0.33f * (1 + lerp * 3);

					Разрабатывается!
					'''
			}
		}

		FrozenHellstone: {
			FrozenHellstoneHeadMelee: {
				DisplayName: Эндообсидиановый авангардский шлем
				Tooltip:
					'''
					Увеличивает истинный урон ближнего боя на 18%
					Атаки истинного ближнего боя накладывают дебафф [cbuff:Frostburn]
					Враги чаще выбирают вас в качестве цели
					'''
				SetBonus:
					'''
					Вы не можете замёрзнуть
					Нажмите {0}, чтобы выдвинуть ледяной щит, позволяющий парировать любую атаку
					'''
			}

			FrozenHellstoneGreaves: {
				DisplayName: Эндообсидиановые поножи
				Tooltip:
					'''
					Увеличивает истинный урон ближнего боя на 20%
					Увеличивает максимальный запас здоровья на 75 ед.
					Враги чаще выбирают вас в качестве цели
					'''
			}

			FrozenHellstoneChestplate: {
				DisplayName: Эндообсидиановый тяжёлый нагрудник
				Tooltip:
					'''
					Увеличивает истинный урон ближнего боя и скорость атаки ближнего боя на 20%
					Враги чаще выбирают вас в качестве цели
					'''
			}
		}