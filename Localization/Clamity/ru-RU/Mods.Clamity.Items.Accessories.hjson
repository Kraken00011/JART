			'''
		HoldShiftTooltip: "   Количество восстанавливаемого времени полёта соразмерно делённой надвое разнице количества полученного урона к общему количеству здоровья"
	}
}

SoulOfPyrogen: {
	DisplayName: Эссенция Пирогена
	Tooltip:
		'''
		Увеличивает разбойный урон и урон ближнего боя на 10%
		Удары истинного ближнего боя и скрытные удары вызывают колья из глубин самой преисподней
		'''
}

DraculasCharm: {
	DisplayName: Амулет Дракулы
	Tooltip:
		'''
		Увеличивает разбойный урон на 15% и максимальную скрытность на 10
		Разбойные критические удары крадут здоровье
		При скрытном ударе на 10 секунд увеличивает шанс критического удара и кражи здоровья на 15% для всех разбойных атак, кроме скрытных
		При скрытном ударе увеличивает урон на 8% и накладывает дебаффы [cbuff:CalamityMod/HeavyBleeding], и [cbuff:CalamityMod/ArmorCrunch]
		При скрытном ударе призывает рой крадущих здоровье летучих мышей-вампиров
		Разбойные снаряды взрываются при столкновении и выпускают самонаводящихся духов
		'Использование этого амулета значительно увеличит вашу жажду крови и душ'
		'''
}

PyroStone: {
	DisplayName: Пирокамень
	Tooltip:
		'''
		Увеличивает урон всех накладываемых игроком дебаффов жара в 1,5 раза
		Создаёт кольцо из огненного щита, которое наносит урон и поджигает врагов
		'Одна из древнейших реликвий'
		'''
}

HellFlare: {
	DisplayName: Адская вспышка
	Tooltip:
		'''
		Атаки накладывают дебафф [cbuff:OnFire3]
		Даёт невосприимчивость к дебаффам [cbuff:OnFire] и [cbuff:OnFire3]
		Увеличивает шанс критического удара на 10%, если ваше здоровье выше 50%
		Увеличивает сопротивление урону на 10%, если ваше здоровье ниже 50%
		Даёт невосприимчивость к атакам холода
		'''
}

SupremeBarrier: {
	DisplayName: Высший барьер
	Tooltip:
		'''
		{$Mods.CalamityMod.Common.KnockbackImmunity}
		Позволяет совершать рывок, усиленный космическим инферно
		Рывок позволяет пробиваться сквозь врагов, не получая контактного урона
		При получении урона выпускает рой самонаводящихся звёздных пчёл[TOGGLE] и даёт бафф [cbuff:Honey]
		Даёт дополнительные кадры неуязвимости; эффект усиливается при низком уровне здоровья или получении значительного урона
		Снижает получаемый урон на 25%, если ваше здоровье ниже 50%
		Перенаправляет на владельца щита 25% урона, нанесённого игрокам вашей команды, если здоровье владельца выше 25%
		[c/aaaaaa:Нажмите Shift+ПКМ по этому предмету в инвентаре, чтобы переключить эффект] [i:PanicNecklace] [c/aaaaaa:ожерелья паники]
		'''
	ToggleEffect: ", увеличивает скорость передвижения"
}

