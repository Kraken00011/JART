	}

	Frostburn: {
		ItemTooltipPlayer: 8 ед. урона в секунду
		ItemTooltipEnemy: 8 ед. урона в секунду
		ItemTooltipPlayerCalamity: "{$Terraria.Buffs.Frostburn.ItemTooltipPlayer}"
		ItemTooltipEnemyCalamity: "{$Terraria.Buffs.Frostburn.ItemTooltipEnemy}"
